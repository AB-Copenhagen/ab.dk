# Strapi CMS
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=
STRAPI_WEBHOOK_SECRET=
# Must match Strapi Cloud's PREVIEW_SECRET env var — validates requests to /api/preview
PREVIEW_SECRET=
# Strapi Cloud's media CDN hostname — proxied through /media so it never appears
# in URLs. Defaults to the current project's host; only needed if that changes.
STRAPI_MEDIA_HOST=

# Sports Innovation API
SI_API_BASE_URL=https://ss2.tjekscores.dk
SI_ACCESS_TOKEN=
SI_TEAM_LOGO_BASE_URL=https://dxugi372p6nmc.cloudfront.net/spdk/current/64x64
AB_TEAM_ID=9805
AB_TOURNAMENT_ID=85
AB_SEASON_ID=36245

# Descope auth
DESCOPE_PROJECT_ID=
DESCOPE_MANAGEMENT_KEY=

# EventBilletten membership webhook — authenticates POST /api/eventbilletten-webhook,
# which mirrors subscription tier changes into Descope's `currentTier` custom
# attribute. See src/pages/api/eventbilletten-webhook.ts for assumptions to confirm
# against EventBilletten's actual webhook contract. Generate with e.g. `openssl rand -hex 32`.
EVENTBILLETTEN_WEBHOOK_SECRET=

# EventBilletten's ticketing platform is vivenu (docs.vivenu.com) — this seller
# API key powers "My Tickets" / subscription status on /myab via
# src/lib/eventbilletten-admin.ts (looks up a fan's tickets and subscriptions by
# their Descope-verified email). Needs the customers:list, tickets:list,
# subscriptions:list and events:list permissions. Create it in vivenu's seller
# admin under API keys.
EVENTBILLETTEN_API_URL=https://vivenu.com/api
EVENTBILLETTEN_API_KEY=

# Mailgun (EU region)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
MAILGUN_LIST_ADDRESS=

# Contact
CONTACT_EMAIL=kontakt@ab.dk
# Where the contact form routes "Partnerships" topic submissions. Falls back
# to CONTACT_EMAIL if unset — see actual value in Vercel, not source control.
PARTNERSHIP_EMAIL=

# Shopify (optional — homepage featured products)
# SHOPIFY_STOREFRONT_ACCESS_TOKEN is the public Storefront API access token
# (Shopify admin → Settings → Apps → your app → API credentials). Not a secret —
# the Storefront API is designed to be called from public clients.
SHOPIFY_DOMAIN=shop.ab.dk
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Admin API credentials (read_customers + read_orders scopes — also grant
# read_all_orders, or order history older than 60 days silently won't show up)
# — real secrets, unlike the Storefront token above. Power "My Orders" on /myab via
# src/lib/shopify-admin.ts (looks up a fan's order history by their
# Descope-verified email). Set ONE of the following two, depending on how the
# custom app was created:
#   - a legacy custom app (Shopify admin → Settings → Apps and develop apps)
#     gives a static Admin API access token directly — set
#     SHOPIFY_ADMIN_API_ACCESS_TOKEN and leave the client id/secret below blank.
#   - an app built on Shopify's Dev Dashboard gives a client_id/client_secret
#     pair instead, with no static token — set SHOPIFY_CLIENT_ID and
#     SHOPIFY_CLIENT_SECRET and leave SHOPIFY_ADMIN_API_ACCESS_TOKEN blank;
#     shopify-admin.ts exchanges them for a short-lived access token itself
#     (Shopify's client_credentials grant) and caches/renews it automatically.
#     Only works when the app and this store are in the same Shopify
#     organization in the Dev Dashboard.
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Wasabi media storage
WASABI_BUCKET=
WASABI_REGION=eu-central-1
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=

# Authenticates Vercel Cron's daily hit to /api/cron/sitemap — Vercel sends
# `Authorization: Bearer $CRON_SECRET` automatically when this is set as a
# project env var. Generate with e.g. `openssl rand -hex 32`.
CRON_SECRET=

# App
PORT=1889
HOST=0.0.0.0

# Search indexing — schema in astro.config.mjs, default false (blocked).
# Set to true before production launch (see README).
ALLOW_SEARCH_INDEXING=

# PostHog analytics (product analytics + web analytics, no session replay — see
# src/lib/posthog-client.ts). Public project API token, from the shared "AB Web"
# PostHog project (also used by media.ab.dk). Schema in astro.config.mjs.
PUBLIC_POSTHOG_KEY=
