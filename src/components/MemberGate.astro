---
// Gates arbitrary content behind a membership tier. The default slot renders
// normally once unlocked; until then it's shown blurred as a visual preview —
// fine for a locked video thumbnail or product shot, but NOT safe for article/
// text bodies, since the markup (and the full text) still ships in the HTML
// either way and a blur is trivially bypassed via view-source. For text
// content, pass an explicit `preview` slot containing only the truncated
// preview (e.g. the article's first paragraph) and fetch/render the full body
// only when `unlocked` is already known server-side — never pass the full body
// into this component's default slot for gated text.
import type { Locale } from '@/lib/i18n';
import { hasTier, type MembershipTier } from '@/lib/membership';

export interface Props {
  requiredTier: MembershipTier;
  locale?: Locale;
  /** Defaults to the current URL — where the login/upgrade CTA sends the visitor back to. */
  redirectTo?: string;
}

const { requiredTier, locale = Astro.locals.locale, redirectTo = Astro.url.pathname } = Astro.props;

const user = Astro.locals.user;
const unlocked = hasTier(user?.currentTier, requiredTier);
const isLoggedIn = Boolean(user);

const loginUrl = locale === 'en' ? '/en/account' : '/konto';
const myabUrl = locale === 'en' ? '/en/myab' : '/myab';
const redirectParam = encodeURIComponent(redirectTo);

const COPY = {
  da: {
    plus: 'MyAB Plus',
    premium: 'MyAB Premium',
    loggedOutTitle: (tier: string) => `Kun for ${tier}-medlemmer`,
    loggedOutBody: 'Log ind eller bliv medlem for at se dette indhold.',
    loggedOutCta: 'Log ind',
    upgradeTitle: (tier: string) => `Opgrader til ${tier}`,
    upgradeBody: 'Dit nuværende medlemskab giver ikke adgang til dette indhold.',
    upgradeCta: 'Se medlemskaber',
  },
  en: {
    plus: 'MyAB Plus',
    premium: 'MyAB Premium',
    loggedOutTitle: (tier: string) => `${tier} members only`,
    loggedOutBody: 'Log in or become a member to view this content.',
    loggedOutCta: 'Log in',
    upgradeTitle: (tier: string) => `Upgrade to ${tier}`,
    upgradeBody: "Your current membership doesn't include this content.",
    upgradeCta: 'See membership plans',
  },
} as const;

const t = COPY[locale ?? 'da'];
const tierLabel = requiredTier === 'premium' ? t.premium : t.plus;
---

{unlocked ? (
  <slot />
) : (
  <div class="relative overflow-hidden rounded border border-neutral-200">
    <div class="pointer-events-none select-none blur-sm opacity-40" aria-hidden="true">
      <slot name="preview">
        <slot />
      </slot>
    </div>
    <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-t from-white via-white/90 to-white/40 p-6">
      <div class="max-w-sm text-center">
        <span class="mb-3 inline-flex size-10 items-center justify-center rounded-full bg-ab-green">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </span>
        <p class="mb-1 text-xs font-black uppercase tracking-widest text-ab-gold">{tierLabel}</p>
        <h3 class="mb-2 text-lg font-black text-neutral-900">
          {isLoggedIn ? t.upgradeTitle(tierLabel) : t.loggedOutTitle(tierLabel)}
        </h3>
        <p class="mb-4 text-sm text-neutral-600">
          {isLoggedIn ? t.upgradeBody : t.loggedOutBody}
        </p>
        <a
          href={isLoggedIn ? myabUrl : `${loginUrl}?redirect=${redirectParam}`}
          class="inline-flex items-center justify-center rounded bg-ab-green px-5 py-2.5 text-sm font-black text-white no-underline transition-colors hover:bg-ab-green/90"
        >
          {isLoggedIn ? t.upgradeCta : t.loggedOutCta}
        </a>
      </div>
    </div>
  </div>
)}
