---
import { loadUserProfile } from '@/lib/descope-server';
import { fetchOrdersByEmail, shopifyOrdersConfigured as ordersConfigured } from '@/lib/shopify-admin';
import { fetchMemberDataByEmail } from '@/lib/eventbilletten-admin';
import { normalizeTier } from '@/lib/membership';
import type { Locale } from '@/lib/i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const user = Astro.locals.user;
const tier = normalizeTier(user?.currentTier);

const orders = user?.email ? await fetchOrdersByEmail(user.email).catch(() => []) : [];
const { tickets, subscriptions } = user?.email
  ? await fetchMemberDataByEmail(user.email, user.eventbillettenUuid).catch(() => ({ tickets: [], subscriptions: [] }))
  : { tickets: [], subscriptions: [] };

// A single Management API lookup for the profile fields the session JWT doesn't
// carry (first/full name, account creation time) — scoped to this one
// dashboard view, not every page.
const profile = user?.userId ? await loadUserProfile(user.userId) : {};
const fullName = profile.name ?? user?.name;
const firstName = profile.givenName ?? fullName?.trim().split(/\s+/)[0];
const memberSinceYear = profile.createdAt?.getFullYear();

const upcomingTickets = tickets.filter((t) => t.status === 'VALID');
const activeSubscription = subscriptions.find((s) => s.status === 'ACTIVE');

const accountHref = locale === 'en' ? '/en/account/profile' : '/konto/profil';
const ticketsHref = locale === 'en' ? '/en/myab/tickets' : '/myab/billetter';
const ordersHref = locale === 'en' ? '/en/myab/orders' : '/myab/ordrer';
// Per the /myab-new draft's own FAQ copy, membership is purchased and managed
// entirely in-app (App Store / Google Play in-app purchase) — there is no web
// checkout or self-service portal. EventBilletten is the subscription-of-record
// behind that IAP, not a separate billing destination of its own.
const manageMembershipHref = '/api/app';

const T = {
  da: {
    hello: (name: string) => `Velkommen, ${name}!`,
    fallbackName: 'Fan',
    memberSince: (year: number) => `Medlem siden ${year}`,
    tierLabel: { free: 'Gratis', plus: 'MyAB Plus', premium: 'MyAB Premium' },
    membershipTitle: 'Medlemskab',
    membershipManage: 'Administrer medlemskab',
    membershipFreeHint: 'Du har ikke et betalt MyAB-medlemskab endnu.',
    membershipUpgrade: 'Se Plus & Premium',
    ticketsTitle: 'Mine billetter',
    ticketsComingSoon: 'Kommer snart — dine EventBilletten-billetter vil blive vist her.',
    ticketsNotConfigured: 'Billetoversigt er ikke konfigureret endnu.',
    ticketsEmpty: 'Ingen kommende billetter fundet.',
    ticketsCount: (n: number) => (n === 1 ? '1 kommende billet' : `${n} kommende billetter`),
    subscriptionActive: (plan: string) => `Aktivt abonnement: ${plan}`,
    ticketsViewAll: 'Se mine billetter',
    ordersTitle: 'Mine ordrer',
    ordersEmpty: 'Ingen ordrer fundet i AB Store.',
    ordersNotConfigured: 'Ordrehistorik er ikke konfigureret endnu.',
    ordersViewAll: 'Se alle ordrer',
    viewOrder: 'Se ordre',
    profileTitle: 'Profil & sikkerhed',
    profileBody: 'Opdater navn, e-mail og login-metoder.',
    profileManage: 'Administrer profil',
  },
  en: {
    hello: (name: string) => `Welcome, ${name}!`,
    fallbackName: 'Fan',
    memberSince: (year: number) => `Member since ${year}`,
    tierLabel: { free: 'Free', plus: 'MyAB Plus', premium: 'MyAB Premium' },
    membershipTitle: 'Membership',
    membershipManage: 'Manage membership',
    membershipFreeHint: "You don't have a paid MyAB membership yet.",
    membershipUpgrade: 'See Plus & Premium',
    ticketsTitle: 'My tickets',
    ticketsComingSoon: "Coming soon — your EventBilletten tickets will show up here.",
    ticketsNotConfigured: 'Ticket overview is not configured yet.',
    ticketsEmpty: 'No upcoming tickets found.',
    ticketsCount: (n: number) => (n === 1 ? '1 upcoming ticket' : `${n} upcoming tickets`),
    subscriptionActive: (plan: string) => `Active subscription: ${plan}`,
    ticketsViewAll: 'See my tickets',
    ordersTitle: 'My orders',
    ordersEmpty: 'No orders found in the AB Store.',
    ordersNotConfigured: 'Order history is not configured yet.',
    ordersViewAll: 'See all orders',
    viewOrder: 'View order',
    profileTitle: 'Profile & security',
    profileBody: 'Update your name, email, and login methods.',
    profileManage: 'Manage profile',
  },
}[locale];

const ticketsConfigured = Boolean(import.meta.env.EVENTBILLETTEN_API_KEY);
---

<section class="bg-[#F2F2F0] border-b border-[#E5E7EB] py-10">
  <div class="max-w-7xl mx-auto px-8 lg:px-20">
    <p class="font-black text-[0.65rem] uppercase tracking-[0.14em] text-ab-green mb-2">
      {T.tierLabel[tier]}
    </p>
    <h1 class="font-black text-[#111]" style="font-size:clamp(1.75rem,3.5vw,2.5rem);letter-spacing:-0.03em">
      {T.hello(firstName || T.fallbackName)}
    </h1>
    {memberSinceYear && <p class="mt-2 text-sm text-[#666]">{T.memberSince(memberSinceYear)}</p>}
  </div>
</section>

<section class="bg-white py-10">
  <div class="max-w-7xl mx-auto px-8 lg:px-20 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">

    <!-- Membership -->
    <div class="bg-white border border-[#E5E7EB] p-6 flex flex-col">
      <p class="font-black text-[0.65rem] uppercase tracking-[0.14em] text-ab-green mb-3">{T.membershipTitle}</p>
      <p class="font-black text-lg text-[#111] mb-2">{T.tierLabel[tier]}</p>
      {tier === 'free' && <p class="text-sm text-[#666] mb-4">{T.membershipFreeHint}</p>}
      <a
        href={manageMembershipHref}
        class="mt-auto inline-flex items-center justify-center rounded bg-ab-green px-4 py-2 text-sm font-black text-white no-underline transition-colors hover:bg-ab-green/90"
      >
        {tier === 'free' ? T.membershipUpgrade : T.membershipManage}
      </a>
    </div>

    <!-- My Tickets -->
    <div class="bg-white border border-[#E5E7EB] p-6 flex flex-col">
      <p class="font-black text-[0.65rem] uppercase tracking-[0.14em] text-ab-green mb-3">{T.ticketsTitle}</p>
      {!ticketsConfigured ? (
        <p class="text-sm text-[#666] mb-4">{T.ticketsNotConfigured}</p>
      ) : (
        <>
          {activeSubscription && (
            <p class="text-sm font-black text-[#111] mb-1">
              {T.subscriptionActive(activeSubscription.planName ?? activeSubscription.planId)}
            </p>
          )}
          <p class="text-sm text-[#666] mb-4">
            {upcomingTickets.length === 0 ? T.ticketsEmpty : T.ticketsCount(upcomingTickets.length)}
          </p>
        </>
      )}
      <a href={ticketsHref} class="mt-auto text-sm font-black text-ab-green no-underline hover:underline">
        {T.ticketsViewAll} →
      </a>
    </div>

    <!-- My Orders -->
    <div class="bg-white border border-[#E5E7EB] p-6 flex flex-col sm:col-span-2 lg:col-span-1">
      <p class="font-black text-[0.65rem] uppercase tracking-[0.14em] text-ab-green mb-3">{T.ordersTitle}</p>
      {!ordersConfigured ? (
        <p class="text-sm text-[#666]">{T.ordersNotConfigured}</p>
      ) : orders.length === 0 ? (
        <p class="text-sm text-[#666]">{T.ordersEmpty}</p>
      ) : (
        <ul class="space-y-3 mb-4">
          {orders.slice(0, 5).map((order) => (
            <li class="flex items-center justify-between gap-3 text-sm">
              <div>
                <p class="font-black text-[#111]">{order.name}</p>
                <p class="text-[#666]">{new Date(order.processedAt).toLocaleDateString(locale === 'da' ? 'da-DK' : 'en-GB')}</p>
              </div>
              {order.statusPageUrl && (
                <a href={order.statusPageUrl} target="_blank" rel="noreferrer" class="shrink-0 underline hover:text-ab-green transition-colors">
                  {T.viewOrder}
                </a>
              )}
            </li>
          ))}
        </ul>
      )}
      <a href={ordersHref} class="mt-auto text-sm font-black text-ab-green no-underline hover:underline">
        {T.ordersViewAll} →
      </a>
    </div>

    <!-- Profile & security -->
    <div class="bg-white border border-[#E5E7EB] p-6 flex flex-col">
      <p class="font-black text-[0.65rem] uppercase tracking-[0.14em] text-ab-green mb-3">{T.profileTitle}</p>
      <p class="text-sm text-[#666] mb-4">{T.profileBody}</p>
      <a
        href={accountHref}
        class="mt-auto inline-flex items-center justify-center rounded border border-[#111] px-4 py-2 text-sm font-black text-[#111] no-underline transition-colors hover:bg-[#111] hover:text-white"
      >
        {T.profileManage}
      </a>
    </div>

  </div>
</section>
