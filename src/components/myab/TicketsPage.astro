---
import { fetchMemberDataByEmail, groupTicketsByEvent } from '@/lib/eventbilletten-admin';
import type { Locale } from '@/lib/i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const user = Astro.locals.user;
const myabHref = locale === 'en' ? '/en/myab' : '/myab';

const { tickets, subscriptions } = user?.email
  ? await fetchMemberDataByEmail(user.email, user.eventbillettenUuid).catch(() => ({ tickets: [], subscriptions: [] }))
  : { tickets: [], subscriptions: [] };
const ticketsConfigured = Boolean(import.meta.env.EVENTBILLETTEN_API_KEY);

const dateFormat = locale === 'da' ? 'da-DK' : 'en-GB';

// One card per event (a season ticket is many per-seat ticket rows for the
// same match — billet.ab.dk's own "My Tickets" page groups the same way) and
// "upcoming" judged from the event's own date — a ticket's status only
// tracks whether it's been invalidated/superseded, not whether the match has
// already been played. An event with no resolved date falls into "past"
// rather than disappearing silently.
const now = Date.now();
const eventGroups = groupTicketsByEvent(tickets);
const isUpcoming = (g: (typeof eventGroups)[number]) =>
  g.eventStart ? new Date(g.eventStart).getTime() > now : false;
const upcomingGroups = eventGroups
  .filter(isUpcoming)
  .sort((a, b) => new Date(a.eventStart!).getTime() - new Date(b.eventStart!).getTime());
const pastGroups = eventGroups
  .filter((g) => !isUpcoming(g))
  .sort((a, b) => new Date(b.eventStart ?? 0).getTime() - new Date(a.eventStart ?? 0).getTime());

const T = {
  da: {
    title: 'Mine billetter',
    back: '← Tilbage til MyAB-konto',
    notConfigured: 'Billetoversigt er ikke konfigureret endnu.',
    meanwhile: 'I mellemtiden kan du se og købe billetter på billet.ab.dk.',
    cta: 'Gå til billet.ab.dk',
    subscriptionsTitle: 'Mit abonnement',
    subscriptionStatus: {
      DRAFT: 'Udkast',
      ACTIVE: 'Aktivt',
      INCOMPLETE: 'Ufuldstændigt',
      CANCELED: 'Opsagt',
      ARCHIVED: 'Arkiveret',
      'PENDING-CANCELLATION': 'Opsiges',
    } as Record<string, string>,
    nextBilling: (date: string) => `Næste betaling: ${date}`,
    ticketsTitle: 'Kommende billetter',
    pastTicketsTitle: 'Tidligere billetter',
    ticketsEmpty: 'Ingen billetter fundet.',
    ticketCount: (n: number) => (n === 1 ? '1 billet' : `${n} billetter`),
  },
  en: {
    title: 'My Tickets',
    back: '← Back to MyAB Account',
    notConfigured: 'Ticket overview is not configured yet.',
    meanwhile: 'In the meantime, you can view and buy tickets at billet.ab.dk.',
    cta: 'Go to billet.ab.dk',
    subscriptionsTitle: 'My subscription',
    subscriptionStatus: {
      DRAFT: 'Draft',
      ACTIVE: 'Active',
      INCOMPLETE: 'Incomplete',
      CANCELED: 'Canceled',
      ARCHIVED: 'Archived',
      'PENDING-CANCELLATION': 'Ending soon',
    } as Record<string, string>,
    nextBilling: (date: string) => `Next billing date: ${date}`,
    ticketsTitle: 'Upcoming tickets',
    pastTicketsTitle: 'Past tickets',
    ticketsEmpty: 'No tickets found.',
    ticketCount: (n: number) => (n === 1 ? '1 ticket' : `${n} tickets`),
  },
}[locale];
---

<section class="bg-white py-14">
  <div class="max-w-3xl mx-auto px-8">
    <a href={myabHref} class="inline-block mb-6 text-sm font-bold text-[#666] no-underline hover:text-ab-green transition-colors">
      {T.back}
    </a>
    <h1 class="font-black text-[#111] mb-6" style="font-size:clamp(1.75rem,3.5vw,2.5rem);letter-spacing:-0.03em">
      {T.title}
    </h1>

    {!ticketsConfigured ? (
      <div class="border border-[#E5E7EB] rounded p-8">
        <p class="text-[#666] mb-4">{T.notConfigured}</p>
        <p class="text-sm text-[#666] mb-5">{T.meanwhile}</p>
        <a
          href="https://billet.ab.dk/"
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center justify-center rounded bg-ab-green px-5 py-2.5 text-sm font-black text-white no-underline transition-colors hover:bg-ab-green/90"
        >
          {T.cta}
        </a>
      </div>
    ) : (
      <>
        {subscriptions.length > 0 && (
          <div class="mb-10">
            <p class="font-black text-[0.65rem] uppercase tracking-[0.14em] text-ab-green mb-3">{T.subscriptionsTitle}</p>
            <ul class="divide-y divide-[#E5E7EB] border border-[#E5E7EB] rounded">
              {subscriptions.map((sub) => (
                <li class="px-5 py-4">
                  <div class="flex items-center justify-between gap-4">
                    <p class="font-black text-[#111]">{sub.planName ?? sub.planId}</p>
                    <p class="text-sm text-[#666]">{T.subscriptionStatus[sub.status] ?? sub.status}</p>
                  </div>
                  {sub.nextBillingDate && (
                    <p class="text-sm text-[#666] mt-1">
                      {T.nextBilling(new Date(sub.nextBillingDate).toLocaleDateString(dateFormat))}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}

        {eventGroups.length === 0 ? (
          <>
            <p class="font-black text-[0.65rem] uppercase tracking-[0.14em] text-ab-green mb-3">{T.ticketsTitle}</p>
            <p class="text-[#666]">{T.ticketsEmpty}</p>
          </>
        ) : (
          <>
            {upcomingGroups.length > 0 && (
              <div class="mb-10">
                <p class="font-black text-[0.65rem] uppercase tracking-[0.14em] text-ab-green mb-3">{T.ticketsTitle}</p>
                <ul class="divide-y divide-[#E5E7EB] border border-[#E5E7EB] rounded">
                  {upcomingGroups.map((group) => (
                    <li class="flex items-center justify-between gap-4 px-5 py-4">
                      <div>
                        <p class="font-black text-[#111]">{group.eventName ?? group.eventId}</p>
                        <p class="text-sm text-[#666]">
                          {group.eventStart && new Date(group.eventStart).toLocaleDateString(dateFormat)}
                        </p>
                      </div>
                      <p class="text-sm font-black text-[#111] shrink-0">
                        {T.ticketCount(group.validCount)}
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {pastGroups.length > 0 && (
              <div>
                <p class="font-black text-[0.65rem] uppercase tracking-[0.14em] text-[#666] mb-3">{T.pastTicketsTitle}</p>
                <ul class="divide-y divide-[#E5E7EB] border border-[#E5E7EB] rounded opacity-70">
                  {pastGroups.map((group) => (
                    <li class="flex items-center justify-between gap-4 px-5 py-4">
                      <div>
                        <p class="font-black text-[#111]">{group.eventName ?? group.eventId}</p>
                        <p class="text-sm text-[#666]">
                          {group.eventStart && new Date(group.eventStart).toLocaleDateString(dateFormat)}
                        </p>
                      </div>
                      <p class="text-sm font-black text-[#111] shrink-0">
                        {T.ticketCount(group.validCount)}
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </>
        )}
      </>
    )}
  </div>
</section>
