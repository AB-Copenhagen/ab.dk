---
interface Props {
  instagramUrl?: string | null;
}

const { instagramUrl } = Astro.props;

// "https://www.instagram.com/g.noga/" → "@g.noga"
const handle = instagramUrl
  ? `@${instagramUrl.replace(/\/+$/, '').split('/').pop()?.split('?')[0]}`
  : null;
---

{
  instagramUrl && (
    // aria-label also opts out of the global "↗" that global.css adds to
    // a[target='_blank'] links without one.
    <a
      href={instagramUrl}
      target="_blank"
      aria-label={`Instagram ${handle}`}
      rel="noopener noreferrer"
      class="mt-6 inline-flex items-center gap-2 font-bold text-ab-green hover:underline"
    >
      <svg
        class="w-5 h-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
        <path d="M17.5 6.5h.01" />
      </svg>
      {handle}
    </a>
  )
}
