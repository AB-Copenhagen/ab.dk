---
import Img from '@/components/Img.astro';

interface Props {
  locale: 'da' | 'en';
}

const { locale } = Astro.props;

const t = {
  da: {
    eyebrow: 'Gladsaxe Stadion',
    heading: 'Kampdag Guide',
    body: 'Alt hvad du skal vide for at have den bedste oplevelse på Gladsaxe Stadion — transport, parkering og stadioninfo.',
    cta: 'Se kampdag guide',
    href: '/kampdag',
  },
  en: {
    eyebrow: 'Gladsaxe Stadium',
    heading: 'Matchday Guide',
    body: 'Everything you need to know to have the best time at Gladsaxe Stadium — transport, parking, and stadium info.',
    cta: 'Go to guide',
    href: '/en/matchday',
  },
}[locale];
---

<section class="relative overflow-hidden rounded-[4px]" style="min-height:280px;background:var(--surface-ground)">
  <Img
    src="/images/about-stadium-seat.png"
    alt=""
    aria-hidden="true"
    class="absolute inset-0 w-full h-full object-cover object-center"
    style="opacity:0.75"
  />
  <div
    class="absolute inset-0"
    style="background:linear-gradient(135deg,color-mix(in srgb, var(--surface-ground) 72%, transparent) 30%,color-mix(in srgb, var(--surface-ground) 35%, transparent))"
  />
  <div class="relative z-10 flex flex-col items-center text-center px-8 py-14">
    <p class="text-[0.6rem] font-bold uppercase tracking-[0.2em] mb-4" style="color:var(--ab-neon)">{t.eyebrow}</p>
    <h2 class="font-black text-white uppercase mb-4" style="font-size:clamp(1.75rem,4vw,2.75rem);letter-spacing:-0.02em">
      {t.heading}
    </h2>
    <p class="text-white/60 max-w-md mb-8 leading-relaxed" style="font-size:0.9375rem">
      {t.body}
    </p>
    <a
      href={t.href}
      class="font-black uppercase no-underline px-8 py-3 rounded transition-opacity hover:opacity-90"
      style="background:var(--ab-neon);color:var(--ab-green);font-size:0.8rem;letter-spacing:0.08em"
    >
      {t.cta}
    </a>
  </div>
</section>
