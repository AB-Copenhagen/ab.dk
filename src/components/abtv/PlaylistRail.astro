---
// Sidebar for the ABTV watch page: "Up next" (other videos in the same
// section as the one playing, which also drives autoplay-next — the
// autoplay checkbox's state is persisted in localStorage, read by
// AbtvPlayer.astro's client script), followed by the other categories so a
// visitor can browse beyond just the current playlist without going back
// to the grid.
import { hasTier } from '@/lib/membership';
import { youTubeThumbnailUrl } from '@/lib/video';
import type { StrapiAbtvVideo } from '@/lib/strapi/client';
import type { Locale } from '@/lib/i18n';

interface Props {
  currentVideo: StrapiAbtvVideo;
  allVideos: StrapiAbtvVideo[];
  locale: Locale;
}

const { currentVideo, allVideos, locale } = Astro.props;

const user = Astro.locals.user;

const COPY = {
  da: {
    upNext: 'Senere',
    autoplay: 'Automatisk afspilning',
    sections: {
      trending: 'Nyt & Trending',
      season: 'Genoplev sæsonen',
      behind_the_scenes: 'Bag om kulisserne',
    },
  },
  en: {
    upNext: 'Up next',
    autoplay: 'Autoplay',
    sections: {
      trending: 'New & Trending',
      season: 'Relive the Season',
      behind_the_scenes: 'Behind the Scenes',
    },
  },
} as const;

const t = COPY[locale ?? 'da'];
const watchBase = locale === 'en' ? '/en/abtv' : '/abtv';

const upNext = allVideos.filter(
  (v) => v.section === currentVideo.section && v.documentId !== currentVideo.documentId
);

const SECTION_ORDER: StrapiAbtvVideo['section'][] = ['trending', 'season', 'behind_the_scenes'];
const otherSections = SECTION_ORDER.filter((key) => key !== currentVideo.section)
  .map((key) => ({ key, heading: t.sections[key], videos: allVideos.filter((v) => v.section === key) }))
  .filter((section) => section.videos.length > 0);

function caption(video: StrapiAbtvVideo) {
  return locale === 'en' ? video.captionEn : video.captionDa;
}
function unlocked(video: StrapiAbtvVideo) {
  return hasTier(user?.currentTier, video.requiredTier);
}
---

<div class="flex flex-col gap-8">
  <div>
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-black text-[#111] text-base">{t.upNext}</h2>
      <label class="flex items-center gap-2 text-xs font-bold text-[#6B7280] cursor-pointer select-none">
        <input type="checkbox" id="abtv-autoplay-toggle" class="size-4 accent-ab-green" />
        {t.autoplay}
      </label>
    </div>
    <div class="flex flex-col gap-3">
      {upNext.map((video) => (
        <a href={`${watchBase}/${video.documentId}`} class="flex gap-3 group no-underline">
          <span class="relative w-32 shrink-0 aspect-video overflow-hidden rounded-md bg-[#111]">
            {!video.isPlaylist && (
              <img
                src={youTubeThumbnailUrl(video.youtubeId)}
                alt={caption(video)}
                class:list={['absolute inset-0 w-full h-full object-cover', !unlocked(video) && 'opacity-40']}
                loading="lazy"
              />
            )}
            {video.isPlaylist && (
              <span class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-[#1a1a1a] to-black">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-70" aria-hidden="true"><rect x="3" y="6" width="14" height="12" rx="1"/><path d="M21 8v8M17 9v6"/></svg>
              </span>
            )}
            {!unlocked(video) && (
              <span class="absolute inset-0 flex items-center justify-center bg-black/55">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </span>
            )}
          </span>
          <span class="text-sm font-bold text-[#111] leading-snug line-clamp-2 group-hover:text-ab-green transition-colors">
            {caption(video)}
          </span>
        </a>
      ))}
    </div>
  </div>

  {otherSections.map((section) => (
    <div>
      <h2 class="font-black text-[#111] text-base mb-4">{section.heading}</h2>
      <div class="flex flex-col gap-3">
        {section.videos.map((video) => (
          <a href={`${watchBase}/${video.documentId}`} class="flex gap-3 group no-underline">
            <span class="relative w-32 shrink-0 aspect-video overflow-hidden rounded-md bg-[#111]">
              {!video.isPlaylist && (
                <img
                  src={youTubeThumbnailUrl(video.youtubeId)}
                  alt={caption(video)}
                  class:list={['absolute inset-0 w-full h-full object-cover', !unlocked(video) && 'opacity-40']}
                  loading="lazy"
                />
              )}
              {video.isPlaylist && (
                <span class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-[#1a1a1a] to-black">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-70" aria-hidden="true"><rect x="3" y="6" width="14" height="12" rx="1"/><path d="M21 8v8M17 9v6"/></svg>
                </span>
              )}
              {!unlocked(video) && (
                <span class="absolute inset-0 flex items-center justify-center bg-black/55">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
              )}
            </span>
            <span class="text-sm font-bold text-[#111] leading-snug line-clamp-2 group-hover:text-ab-green transition-colors">
              {caption(video)}
            </span>
          </a>
        ))}
      </div>
    </div>
  ))}
</div>

<script>
  const checkbox = document.getElementById('abtv-autoplay-toggle') as HTMLInputElement | null;
  if (checkbox) {
    try {
      checkbox.checked = localStorage.getItem('abtv-autoplay') !== 'false';
    } catch {
      checkbox.checked = true;
    }
    checkbox.addEventListener('change', () => {
      try {
        localStorage.setItem('abtv-autoplay', checkbox.checked ? 'true' : 'false');
      } catch {
        /* noop — localStorage unavailable (private mode, etc.) */
      }
    });
  }
</script>
