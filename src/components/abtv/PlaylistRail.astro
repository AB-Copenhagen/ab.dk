---
// "Up next" rail for the ABTV watch page — other videos in the same section,
// plus the autoplay-next checkbox (state persisted in localStorage, read by
// AbtvPlayer.astro's client script).
import { hasTier } from '@/lib/membership';
import { youTubeThumbnailUrl } from '@/lib/video';
import type { StrapiAbtvVideo } from '@/lib/strapi/client';
import type { Locale } from '@/lib/i18n';

interface Props {
  videos: StrapiAbtvVideo[];
  locale: Locale;
}

const { videos, locale } = Astro.props;

const user = Astro.locals.user;

const COPY = {
  da: { heading: 'Senere', autoplay: 'Automatisk afspilning' },
  en: { heading: 'Up next', autoplay: 'Autoplay' },
} as const;

const t = COPY[locale ?? 'da'];
const watchBase = locale === 'en' ? '/en/abtv' : '/abtv';
---

<div>
  <div class="flex items-center justify-between mb-4">
    <h2 class="font-black text-[#111] text-base">{t.heading}</h2>
    <label class="flex items-center gap-2 text-xs font-bold text-[#6B7280] cursor-pointer select-none">
      <input type="checkbox" id="abtv-autoplay-toggle" class="size-4 accent-ab-green" />
      {t.autoplay}
    </label>
  </div>
  <div class="flex flex-col gap-3">
    {videos.map((video) => {
      const caption = locale === 'en' ? video.captionEn : video.captionDa;
      const unlocked = hasTier(user?.currentTier, video.requiredTier);
      return (
        <a href={`${watchBase}/${video.documentId}`} class="flex gap-3 group no-underline">
          <span class="relative w-32 shrink-0 aspect-video overflow-hidden rounded-md bg-[#111]">
            {!video.isPlaylist && (
              <img
                src={youTubeThumbnailUrl(video.youtubeId)}
                alt={caption}
                class:list={['absolute inset-0 w-full h-full object-cover', !unlocked && 'opacity-40']}
                loading="lazy"
              />
            )}
            {video.isPlaylist && (
              <span class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-[#1a1a1a] to-black">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-70" aria-hidden="true"><rect x="3" y="6" width="14" height="12" rx="1"/><path d="M21 8v8M17 9v6"/></svg>
              </span>
            )}
            {!unlocked && (
              <span class="absolute inset-0 flex items-center justify-center bg-black/55">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </span>
            )}
          </span>
          <span class="text-sm font-bold text-[#111] leading-snug line-clamp-2 group-hover:text-ab-green transition-colors">
            {caption}
          </span>
        </a>
      );
    })}
  </div>
</div>

<script>
  const checkbox = document.getElementById('abtv-autoplay-toggle') as HTMLInputElement | null;
  if (checkbox) {
    try {
      checkbox.checked = localStorage.getItem('abtv-autoplay') !== 'false';
    } catch {
      checkbox.checked = true;
    }
    checkbox.addEventListener('change', () => {
      try {
        localStorage.setItem('abtv-autoplay', checkbox.checked ? 'true' : 'false');
      } catch {
        /* noop — localStorage unavailable (private mode, etc.) */
      }
    });
  }
</script>
