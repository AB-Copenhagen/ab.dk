---
// Renders one ABTV video or playlist, gated by MyAB tier. Deliberately NOT
// built on MemberGate or ConsentGatedIframe's locked-state behavior:
// ConsentGatedIframe stashes the real embed URL in a `data-src` attribute
// regardless of consent state (fine for its actual purpose — there's no
// secrecy requirement, just "don't auto-load until consent"), and
// MemberGate's own docs warn its blur-slot approach ships the full gated
// markup either way. Here the tier check happens server-side *before*
// deciding what to render at all — a locked video never has its real
// youtubeId/embed URL anywhere in the response HTML, only a static thumbnail.
import ConsentGatedIframe from '@/components/ConsentGatedIframe.astro';
import { hasTier } from '@/lib/membership';
import { youTubeThumbnailUrl } from '@/lib/video';
import type { StrapiAbtvVideo } from '@/lib/strapi/client';
import type { Locale } from '@/lib/i18n';

interface Props {
  video: StrapiAbtvVideo;
  locale: Locale;
}

const { video, locale } = Astro.props;

const user = Astro.locals.user;
const unlocked = hasTier(user?.currentTier, video.requiredTier);
const isLoggedIn = Boolean(user);
const caption = locale === 'en' ? video.captionEn : video.captionDa;

const loginUrl = locale === 'en' ? '/en/account' : '/konto';
const myabUrl = locale === 'en' ? '/en/myab' : '/myab';
const redirectParam = encodeURIComponent(Astro.url.pathname);

const COPY = {
  da: {
    plus: 'MyAB Plus',
    premium: 'MyAB Premium',
    loggedOutTitle: (tier: string) => `Kun for ${tier}-medlemmer`,
    loggedOutCta: 'Log ind',
    upgradeTitle: (tier: string) => `Opgrader til ${tier}`,
    upgradeCta: 'Se medlemskaber',
  },
  en: {
    plus: 'MyAB Plus',
    premium: 'MyAB Premium',
    loggedOutTitle: (tier: string) => `${tier} members only`,
    loggedOutCta: 'Log in',
    upgradeTitle: (tier: string) => `Upgrade to ${tier}`,
    upgradeCta: 'See membership plans',
  },
} as const;

const t = COPY[locale ?? 'da'];
const tierLabel = video.requiredTier === 'premium' ? t.premium : t.plus;
---

<div>
  <p class="text-white/50 text-xs font-black tracking-[0.12em] uppercase mb-3">{caption}</p>
  {unlocked ? (
    video.isPlaylist ? (
      <ConsentGatedIframe
        src={`https://www.youtube.com/embed/videoseries?list=${video.youtubeId}`}
        title={caption}
        locale={locale}
      />
    ) : (
      <ConsentGatedIframe
        src={`https://www.youtube.com/embed/${video.youtubeId}`}
        title={caption}
        locale={locale}
      />
    )
  ) : (
    <div class="relative w-full rounded-lg overflow-hidden bg-black" style="aspect-ratio:16/9;">
      {!video.isPlaylist && (
        <img
          src={youTubeThumbnailUrl(video.youtubeId)}
          alt={caption}
          class="absolute inset-0 w-full h-full object-cover opacity-50"
          loading="lazy"
        />
      )}
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 px-6 text-center bg-black/60">
        <span class="inline-flex size-10 items-center justify-center rounded-full bg-ab-green">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </span>
        <p class="text-xs font-black uppercase tracking-widest text-ab-gold">{tierLabel}</p>
        <h3 class="text-base font-black text-white">
          {isLoggedIn ? t.upgradeTitle(tierLabel) : t.loggedOutTitle(tierLabel)}
        </h3>
        <a
          href={isLoggedIn ? myabUrl : `${loginUrl}?redirect=${redirectParam}`}
          class="inline-flex items-center justify-center rounded bg-ab-green px-5 py-2.5 text-sm font-black text-white no-underline transition-colors hover:bg-ab-green/90"
        >
          {isLoggedIn ? t.upgradeCta : t.loggedOutCta}
        </a>
      </div>
    </div>
  )}
</div>
