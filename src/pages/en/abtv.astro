---
import Base from '@/layouts/Base.astro';
import VideoCard from '@/components/abtv/VideoCard.astro';
import { fetchAbtvVideos, type StrapiAbtvVideo } from '@/lib/strapi/client';
import { itemListSchema, youTubeVideoSchema } from '@/lib/structured-data';
export const prerender = false;

const videos = await fetchAbtvVideos();

const bySection = (section: StrapiAbtvVideo['section']) =>
  videos.filter((v) => v.section === section);

const SECTIONS: { key: StrapiAbtvVideo['section']; heading: string }[] = [
  { key: 'trending', heading: 'New & Trending' },
  { key: 'season', heading: 'Relive the Season' },
  { key: 'behind_the_scenes', heading: 'Behind the Scenes' },
];

// Only publicly-accessible videos are discoverable here — a locked video's
// real embed never reaches the page (see VideoCard.astro), so it's left out
// of both the ItemList and the per-video VideoObject entries rather than
// advertising a URL that isn't actually servable to an anonymous crawler.
const publicVideos = videos.filter((v) => v.requiredTier === 'free');
const videoSchemas = publicVideos
  .map((v) =>
    youTubeVideoSchema(
      {
        embedCode: v.isPlaylist
          ? `https://www.youtube.com/embed/videoseries?list=${v.youtubeId}`
          : `https://www.youtube.com/embed/${v.youtubeId}`,
        caption: v.captionEn,
      },
      v.uploadDate ?? new Date().toISOString()
    )
  )
  .filter((schema): schema is NonNullable<typeof schema> => schema !== null);

const abtvStructuredData = [itemListSchema('ABTV', videoSchemas), ...videoSchemas];
---

<Base
  locale="en"
  title="ABTV | Match Highlights & Interviews"
  description="Stream match highlights, recaps and exclusive player interviews on ABTV — Akademisk Boldklub's official video channel."
  ogTitle="ABTV – AB's Official Video Hub"
  ogDescription="Catch every goal, recap and behind-the-scenes moment from Akademisk Boldklub on ABTV."
  structuredData={abtvStructuredData}
>

  <!-- ── Hero ──────────────────────────────────────────────────────── -->
  <section class="bg-ab-green text-white pt-16 pb-20 px-8 lg:px-16">
    <div class="max-w-5xl mx-auto">
      <span class="inline-block text-ab-neon font-black text-xs tracking-[0.18em] uppercase mb-5">
        ABTV
      </span>
      <h1 class="font-black leading-[0.95] tracking-[-0.04em] normal-case mb-6"
          style="font-size: clamp(3rem, 8vw, 7rem);">
        Every match.<br>Every highlight.<br>All in one place.
      </h1>
      <p class="text-white/70 font-medium text-lg max-w-xl">
        Stay up to date about our latest matches and must-watch moments.
      </p>
    </div>
  </section>

  {SECTIONS.map(({ key, heading }, i) => {
    const sectionVideos = bySection(key);
    if (sectionVideos.length === 0) return null;
    return (
      <section class:list={['text-white py-14 px-8 lg:px-16', i % 2 === 0 ? 'bg-[#111]' : 'bg-[#0d0d0d]']}>
        <div class="max-w-7xl mx-auto">
          <h2 class="font-black tracking-[-0.04em] normal-case mb-10"
              style="font-size: clamp(2rem, 5vw, 3.5rem);">
            {heading}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {sectionVideos.map((video) => (
              <VideoCard video={video} locale="en" />
            ))}
          </div>
        </div>
      </section>
    );
  })}

  <!-- ── YouTube CTA ───────────────────────────────────────────────── -->
  <section class="bg-ab-green text-white py-14 px-8 lg:px-16">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6">
      <p class="font-black leading-tight tracking-[-0.03em] text-white"
         style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
        See everything on our channel
      </p>
      <a
        href="https://www.youtube.com/@akademisk-boldklub"
        target="_blank"
        rel="noreferrer"
        class="shrink-0 inline-flex items-center gap-3 bg-ab-neon text-ab-green font-black px-8 py-4 text-lg tracking-[-0.02em] hover:bg-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 shrink-0" aria-hidden="true">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        YouTube
      </a>
    </div>
  </section>

</Base>
