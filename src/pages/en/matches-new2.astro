---
// DESIGN PROTOTYPE — "Ticket-marketing" fixtures page, inspired by big-club
// ticketing hubs (e.g. FC Barcelona's Tickets page): a hero spotlight on the
// next match, month-pill navigation, and a card grid where every fixture
// carries its own ticket CTA. Not linked from navigation — compare at
// /en/matches-new2 against the live /en/matches and the alternate
// /en/matches-new (editorial list) prototype.
import Base from '@/layouts/Base.astro';
import MatchCountdown from '@/components/MatchCountdown.astro';
import StandingsWidget from '@/components/StandingsWidget.astro';
import {
  fetchABEvents,
  isCupMatch,
  getTeamLogoSrc,
  cupTournamentLabel,
  type SIEvent,
} from '@/lib/si/client';
import { abConfig } from '@/lib/config/ab';
import { fetchBilletTicketMap, findTicketUrl } from '@/lib/billet';
import { translate } from '@/lib/i18n';
import { fmtDate, dtAttrs, AB_TIMEZONE, TIME_OPTS, GRID_DATE_OPTS } from '@/lib/dateFormat';
import Img from '@/components/Img.astro';
import matchesHeaderBg from '@/assets/images/matches-header-bg.png';
import { setCdnCacheHeaders } from '@/lib/http-cache';
export const prerender = false;
setCdnCacheHeaders(Astro.response.headers);

const locale = 'en';
const dateLocale = 'en-GB';

const now = new Date();
const seasonFrom = new Date(now);
seasonFrom.setMonth(seasonFrom.getMonth() - 1);
const seasonTo = new Date(now);
seasonTo.setMonth(seasonTo.getMonth() + 6);

let events: SIEvent[] = [];
try {
  events = await fetchABEvents({
    locale,
    limit: 200,
    fromDate: seasonFrom.toISOString().slice(0, 10),
    toDate: seasonTo.toISOString().slice(0, 10),
    allCompetitions: true,
  });
} catch {
  /* SI API unavailable */
}

const isDone = (e: SIEvent) =>
  e.statusType === 'finished' || e.statusType === 'cancelled';
// This page is forward-looking (ticket sales), so it shows the run of
// upcoming fixtures rather than every filter the results-heavy pages need.
const upcoming = events
  .filter((e) => !isDone(e))
  .sort((a, b) => new Date(a.startDate).getTime() - new Date(b.startDate).getTime());

const billetMap = await fetchBilletTicketMap().catch(() => new Map<string, string>());
const ticketByEventId: Record<number, string> = {};
for (const event of upcoming) {
  if (event.homeId === abConfig.teamId) {
    const url = findTicketUrl(billetMap, event.awayName ?? '');
    if (url) ticketByEventId[event.eventId] = url;
  }
}

const nextMatch = upcoming[0] ?? null;
const restOfMatches = upcoming.slice(1);

function monthKey(iso: string): string {
  return fmtDate(iso, 'en-CA', { year: 'numeric', month: '2-digit' }, AB_TIMEZONE);
}
function monthLabel(iso: string, short = false): string {
  return fmtDate(iso, dateLocale, { month: short ? 'short' : 'long' }, AB_TIMEZONE);
}

const months: { key: string; label: string; shortLabel: string; matches: SIEvent[] }[] = [];
for (const event of restOfMatches) {
  const key = monthKey(event.startDate);
  let bucket = months.find((m) => m.key === key);
  if (!bucket) {
    bucket = {
      key,
      label: monthLabel(event.startDate),
      shortLabel: monthLabel(event.startDate, true),
      matches: [],
    };
    months.push(bucket);
  }
  bucket.matches.push(event);
}

const matchHref = (id: number) => `/en/match/${id}`;
---

<Base
  locale={locale}
  title="Tickets & Fixtures | Akademisk Boldklub"
  description="Buy tickets for every upcoming AB 1889 home match — fixtures, kickoff times and season cards."
  ogTitle="AB Tickets & Fixtures"
  ogDescription="Buy tickets for every upcoming AB 1889 home match."
>
  <!-- Hero -->
  <div class="relative w-full">
    <Img
      src={matchesHeaderBg}
      alt="AB 1889 at Gladsaxe Stadion"
      class="w-full h-auto block"
      loading="eager"
      fetchpriority="high"
      widths={[640, 828, 1200, 1920, 3840]}
      sizes="100vw"
    />
    <div class="absolute inset-0" style="background:linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.35) 60%, rgba(0,0,0,0.75) 100%);"></div>
    <div class="absolute inset-0 flex flex-col items-center justify-end text-center px-6 pb-12">
      <h1 class="font-black text-white leading-[0.95] tracking-[-0.04em] normal-case mb-3" style="font-size:clamp(2.25rem,7vw,5rem);">
        Tickets &amp; Fixtures
      </h1>
      <p class="text-sm md:text-base text-white/75 max-w-lg mb-6">Every home match is best experienced live at Gladsaxe Stadion — grab your seat before kickoff.</p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a class="vivenu-btn btn btn-md" style="background:var(--ab-neon); color:var(--ab-green);" href="https://billet.ab.dk/?useEmbed=true">Buy Tickets</a>
        <a class="vivenu-btn btn btn-md bg-white/10 text-white border border-white/30" href="https://billet.ab.dk/event/seasonal-ticket-pass-26-27-copy-u8hk6v?useEmbed=true">Season Card</a>
      </div>
    </div>
  </div>

  <!-- Next match spotlight -->
  {nextMatch && (
    <div class="bg-[#0A0A09] py-12 md:py-16">
      <div class="max-w-5xl mx-auto px-6">
        <p class="text-center text-xs font-black uppercase tracking-[0.25em] text-ab-neon mb-8">Next Up</p>
        <div class="flex flex-col md:flex-row items-center justify-center gap-6 md:gap-14 mb-9">
          <div class="flex flex-col items-center gap-3">
            <img
              src={nextMatch.homeId === abConfig.teamId ? '/images/ab-crest.svg' : getTeamLogoSrc(nextMatch.homeId)}
              alt=""
              width="96"
              height="96"
              class="w-20 h-20 md:w-24 md:h-24 object-contain"
              loading="eager"
              onerror="this.style.opacity='0'"
            />
            <span class="font-black text-white text-lg md:text-xl tracking-[-0.02em]">{nextMatch.homeId === abConfig.teamId ? 'AB' : nextMatch.homeName}</span>
          </div>
          <div class="flex flex-col items-center gap-2 shrink-0">
            <span class="font-black text-white/25 text-2xl md:text-3xl tracking-[-0.02em]">VS</span>
            {isCupMatch(nextMatch) && (
              <span class="inline-flex items-center text-[0.65rem] font-black uppercase tracking-[0.05em] text-ab-green bg-ab-beige rounded-full px-2.5 py-1">
                {cupTournamentLabel(nextMatch, locale)}
              </span>
            )}
          </div>
          <div class="flex flex-col items-center gap-3">
            <img
              src={nextMatch.awayId === abConfig.teamId ? '/images/ab-crest.svg' : getTeamLogoSrc(nextMatch.awayId)}
              alt=""
              width="96"
              height="96"
              class="w-20 h-20 md:w-24 md:h-24 object-contain"
              loading="eager"
              onerror="this.style.opacity='0'"
            />
            <span class="font-black text-white text-lg md:text-xl tracking-[-0.02em]">{nextMatch.awayId === abConfig.teamId ? 'AB' : nextMatch.awayName}</span>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-white/60 text-sm mb-7">
          <span {...dtAttrs(nextMatch.startDate, dateLocale, GRID_DATE_OPTS)}>{fmtDate(nextMatch.startDate, dateLocale, GRID_DATE_OPTS)}</span>
          <span class="w-1 h-1 rounded-full bg-white/25"></span>
          <span {...dtAttrs(nextMatch.startDate, dateLocale, TIME_OPTS)}>{fmtDate(nextMatch.startDate, dateLocale, TIME_OPTS)}</span>
          <span class="w-1 h-1 rounded-full bg-white/25"></span>
          <span>{nextMatch.properties?.venueName ?? (nextMatch.homeId === abConfig.teamId ? translate(locale, 'defaultStadium') : nextMatch.homeName)}</span>
        </div>

        <div class="flex justify-center mb-9">
          <MatchCountdown startDate={nextMatch.startDate} locale="en" />
        </div>

        <div class="flex flex-wrap items-center justify-center gap-3">
          {nextMatch.homeId === abConfig.teamId ? (
            <a
              class="vivenu-btn inline-flex items-center gap-2 text-sm font-black uppercase tracking-[0.08em] px-7 py-3.5 rounded-full no-underline text-ab-green"
              style="background:var(--ab-neon);"
              href={`${ticketByEventId[nextMatch.eventId] ?? 'https://billet.ab.dk/'}?useEmbed=true`}
            >
              Buy Tickets
            </a>
          ) : (
            <span class="inline-flex items-center gap-2 text-sm font-black uppercase tracking-[0.08em] px-7 py-3.5 rounded-full text-white/50 border border-white/20">
              Away Match
            </span>
          )}
          <a class="inline-flex items-center gap-2 text-sm font-bold px-7 py-3.5 rounded-full no-underline border border-white/25 text-white hover:bg-white/10 transition-colors" href={matchHref(nextMatch.eventId)}>
            Match Details
          </a>
        </div>
      </div>
    </div>
  )}

  <!-- Month navigation -->
  {months.length > 1 && (
    <div class="bg-white border-b border-gray-200 sticky top-0 z-20">
      <div class="max-w-6xl mx-auto px-4 md:px-6 flex items-center gap-1 h-[52px] overflow-x-auto">
        {months.map((month) => (
          <a
            href={`#month-${month.key}`}
            class="shrink-0 font-bold text-sm px-4 py-1.5 rounded-full no-underline text-[#555] hover:bg-[#F0F4F0] hover:text-ab-green transition-colors"
            style="letter-spacing:-0.01em;"
          >
            {month.shortLabel}
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- Card grid -->
  <div class="bg-[#F5F5F4] py-12 md:py-16">
    <div class="max-w-6xl mx-auto px-4 md:px-6 flex flex-col gap-12">
      {months.length === 0 && (
        <div class="text-center py-16 text-sm text-[#777]">{translate(locale, 'noUpcomingFixtures')}</div>
      )}
      {months.map((month) => (
        <section id={`month-${month.key}`} class="scroll-mt-24">
          <h2 class="font-black uppercase tracking-[-0.02em] text-[#111] mb-5" style="font-size:1.5rem;">{month.label}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {month.matches.map((event) => {
              const isABHome = event.homeId === abConfig.teamId;
              const homeName = isABHome ? 'AB' : event.homeName;
              const awayName = isABHome ? event.awayName : 'AB';
              const isCup = isCupMatch(event);
              const isLive = event.statusType === 'inprogress';
              const venue = event.properties?.venueName ?? (isABHome ? translate(locale, 'defaultStadium') : event.homeName);
              const ticketUrl = ticketByEventId[event.eventId];

              return (
                <div class="group relative flex flex-col bg-white rounded-[8px] border border-gray-200 overflow-hidden hover:shadow-[0_8px_28px_rgba(0,0,0,0.09)] hover:border-gray-300 transition-all duration-150">
                  <a
                    href={matchHref(event.eventId)}
                    class="absolute inset-0 z-0"
                    aria-label={`View match: ${homeName} vs ${awayName}`}
                  />
                  <div class="flex items-center justify-between px-4 py-2 border-b border-gray-100">
                    <span class="text-xs font-bold text-[#555]">
                      <span {...dtAttrs(event.startDate, dateLocale, GRID_DATE_OPTS)}>{fmtDate(event.startDate, dateLocale, GRID_DATE_OPTS)}</span>
                      {' · '}
                      <span {...dtAttrs(event.startDate, dateLocale, TIME_OPTS)}>{fmtDate(event.startDate, dateLocale, TIME_OPTS)}</span>
                    </span>
                    {isLive ? (
                      <span class="inline-flex items-center gap-1.5 text-[0.65rem] font-black uppercase tracking-[0.1em] text-ab-green">
                        <span class="w-1.5 h-1.5 rounded-full bg-current animate-pulse"></span>Live
                      </span>
                    ) : isCup ? (
                      <span class="inline-flex items-center text-[0.6rem] font-black uppercase tracking-[0.05em] text-ab-green bg-ab-beige rounded-full px-2 py-0.5">
                        {cupTournamentLabel(event, locale)}
                      </span>
                    ) : (
                      <span class="text-[0.65rem] font-bold uppercase tracking-[0.04em] text-[#AAA]">{translate(locale, 'secondDivision')}</span>
                    )}
                  </div>

                  <div class="flex items-center justify-center gap-4 px-5 pt-6 pb-6">
                    <div class="flex flex-col items-center gap-2 flex-1 min-w-0">
                      <img src={event.homeId === abConfig.teamId ? '/images/ab-crest.svg' : getTeamLogoSrc(event.homeId)} alt="" width="52" height="52" class="w-12 h-12 object-contain" loading="lazy" onerror="this.style.opacity='0'" />
                      <span class="text-xs font-bold text-[#111] text-center leading-tight line-clamp-2">{homeName}</span>
                    </div>
                    <span class="text-[0.65rem] font-black text-[#CCC] shrink-0">VS</span>
                    <div class="flex flex-col items-center gap-2 flex-1 min-w-0">
                      <img src={event.awayId === abConfig.teamId ? '/images/ab-crest.svg' : getTeamLogoSrc(event.awayId)} alt="" width="52" height="52" class="w-12 h-12 object-contain" loading="lazy" onerror="this.style.opacity='0'" />
                      <span class="text-xs font-bold text-[#111] text-center leading-tight line-clamp-2">{awayName}</span>
                    </div>
                  </div>

                  <div class="px-4 pb-3 -mt-1">
                    <p class="text-[0.7rem] text-[#999] text-center truncate">{venue}</p>
                  </div>

                  <div class="relative z-10 mt-auto px-4 py-3 border-t border-gray-100">
                    {isABHome ? (
                      <a
                        class="vivenu-btn block text-center text-xs font-black uppercase tracking-[0.06em] px-4 py-2.5 rounded no-underline text-white transition-opacity hover:opacity-85"
                        style="background:var(--ab-green);"
                        href={`${ticketUrl ?? 'https://billet.ab.dk/'}?useEmbed=true`}
                      >
                        {ticketUrl ? 'Buy Tickets' : 'Tickets'}
                      </a>
                    ) : (
                      <span class="block text-center text-xs font-bold uppercase tracking-[0.06em] px-4 py-2.5 rounded border border-gray-200 text-[#999]">
                        Away Match
                      </span>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      ))}

      <!-- Group tickets promo -->
      <div class="bg-white rounded-[8px] border border-gray-200 px-6 py-8 md:px-10 md:py-10 flex flex-col md:flex-row items-center justify-between gap-5">
        <div>
          <h3 class="font-black text-[#111] mb-1.5" style="font-size:1.25rem; letter-spacing:-0.02em;">Coming with a group?</h3>
          <p class="text-sm text-[#666]">Groups of 10 or more get a discounted rate and a dedicated block of seats — get in touch with our hospitality team.</p>
        </div>
        <a href="/en/hospitality" class="shrink-0 inline-flex items-center gap-2 text-xs font-black uppercase tracking-[0.08em] px-6 py-3 rounded-full no-underline text-white transition-opacity hover:opacity-85" style="background:var(--ab-green);">
          Group Tickets
        </a>
      </div>
    </div>
  </div>

  <!-- Standings -->
  <div class="bg-white pt-10 pb-14">
    <div class="max-w-6xl mx-auto px-4 md:px-6">
      <h2 class="font-black mb-6 tracking-[-0.04em] text-[#111]" style="font-size:clamp(1.5rem,3.5vw,2rem);">League Table</h2>
      <StandingsWidget locale="en" showHeader={false} highlightTeamIds={[abConfig.teamId]} />
    </div>
  </div>
</Base>
