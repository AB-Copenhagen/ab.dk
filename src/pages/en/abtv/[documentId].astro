---
import Base from '@/layouts/Base.astro';
import AbtvPlayer from '@/components/abtv/AbtvPlayer.astro';
import PlaylistRail from '@/components/abtv/PlaylistRail.astro';
import { fetchAbtvVideoByDocumentId, fetchAbtvVideos } from '@/lib/strapi/client';
import { hasTier } from '@/lib/membership';
import { breadcrumbSchema, youTubeVideoSchema } from '@/lib/structured-data';
export const prerender = false;

const { documentId } = Astro.params;
const video = documentId ? await fetchAbtvVideoByDocumentId(documentId) : null;

if (!video) {
  return Astro.rewrite('/404');
}

const caption = video.captionEn;
const user = Astro.locals.user;
const unlocked = hasTier(user?.currentTier, video.requiredTier);

const allVideos = await fetchAbtvVideos();
const sectionVideos = allVideos.filter(
  (v) => v.section === video.section && v.documentId !== video.documentId
);
const nextVideoUrl = sectionVideos.length > 0 ? `/en/abtv/${sectionVideos[0].documentId}` : null;

const pageUrl = `https://ab.dk/en/abtv/${video.documentId}`;
const embedUrl = video.isPlaylist
  ? `https://www.youtube.com/embed/videoseries?list=${video.youtubeId}`
  : `https://www.youtube.com/embed/${video.youtubeId}`;

const videoSchema = youTubeVideoSchema(
  { embedCode: embedUrl, caption },
  video.uploadDate ?? new Date().toISOString(),
  video.requiredTier === 'free'
);

const abtvBreadcrumbs = breadcrumbSchema([
  { name: 'ABTV', url: 'https://ab.dk/en/abtv/browse' },
  { name: caption, url: pageUrl },
]);

const COPY = {
  plus: 'MyAB Plus',
  premium: 'MyAB Premium',
  loggedOutTitle: (tier: string) => `${tier} members only`,
  loggedOutBody: 'Log in or become a member to watch this video.',
  loggedOutCta: 'Log in',
  upgradeTitle: (tier: string) => `Upgrade to ${tier}`,
  upgradeBody: "Your current membership doesn't include this video.",
  upgradeCta: 'See membership plans',
};
const isLoggedIn = Boolean(user);
const tierLabel = video.requiredTier === 'premium' ? COPY.premium : COPY.plus;
const redirectParam = encodeURIComponent(Astro.url.pathname);
---

<Base
  locale="en"
  title={`${caption} | ABTV`}
  description={`Watch ${caption} on ABTV — Akademisk Boldklub's official video channel.`}
  structuredData={videoSchema ? [abtvBreadcrumbs, videoSchema] : [abtvBreadcrumbs]}
>
  <div class="bg-white px-8 lg:px-16 py-8">
    <div class="max-w-7xl mx-auto">
      <a href="/en/abtv/browse" class="inline-flex items-center gap-1 text-sm font-bold text-[#6B7280] hover:text-ab-green transition-colors mb-4">
        ← ABTV
      </a>
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-8">
        <div>
          {unlocked ? (
            <AbtvPlayer video={video} locale="en" nextVideoUrl={nextVideoUrl} />
          ) : (
            <div class="relative w-full rounded-lg overflow-hidden bg-[#111]" style="aspect-ratio:16/9;">
              <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 px-6 text-center">
                <span class="inline-flex size-12 items-center justify-center rounded-full bg-ab-green">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                <p class="text-xs font-black uppercase tracking-widest text-ab-gold">{tierLabel}</p>
                <h2 class="text-lg font-black text-white">
                  {isLoggedIn ? COPY.upgradeTitle(tierLabel) : COPY.loggedOutTitle(tierLabel)}
                </h2>
                <p class="text-sm text-white/70 max-w-[40ch]">
                  {isLoggedIn ? COPY.upgradeBody : COPY.loggedOutBody}
                </p>
                <a
                  href={isLoggedIn ? '/en/myab' : `/en/account?redirect=${redirectParam}`}
                  class="inline-flex items-center justify-center rounded bg-ab-green px-5 py-2.5 text-sm font-black text-white no-underline transition-colors hover:bg-ab-green/90"
                >
                  {isLoggedIn ? COPY.upgradeCta : COPY.loggedOutCta}
                </a>
              </div>
            </div>
          )}
          <h1 class="mt-4 font-black text-[#111] text-xl md:text-2xl tracking-[-0.02em]">{caption}</h1>
        </div>
        <PlaylistRail currentVideo={video} allVideos={allVideos} locale="en" />
      </div>
    </div>
  </div>
</Base>
