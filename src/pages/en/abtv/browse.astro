---
import Base from '@/layouts/Base.astro';
import VideoCard from '@/components/abtv/VideoCard.astro';
import { fetchAbtvVideos, type StrapiAbtvVideo } from '@/lib/strapi/client';
import { itemListSchema } from '@/lib/structured-data';
import { youTubeThumbnailUrl } from '@/lib/video';
export const prerender = false;

const videos = await fetchAbtvVideos();

const bySection = (section: StrapiAbtvVideo['section']) =>
  videos.filter((v) => v.section === section);

const SECTIONS: { key: StrapiAbtvVideo['section']; heading: string }[] = [
  { key: 'trending', heading: 'New & Trending' },
  { key: 'season', heading: 'Relive the Season' },
  { key: 'behind_the_scenes', heading: 'Behind the Scenes' },
];

// Only publicly-accessible videos are discoverable here — a locked video's
// watch page renders an upsell panel instead of the real player, so it's
// left out of the ItemList rather than advertising a URL whose content isn't
// actually viewable by an anonymous crawler. Each item points at this
// video's own watch page (src/pages/en/abtv/[documentId].astro), which
// carries the full VideoObject schema for that specific video — this list
// stays lightweight rather than duplicating that detail here.
const publicVideos = videos.filter((v) => v.requiredTier === 'free');
const videoListItems = publicVideos.map((v) => ({
  '@type': 'VideoObject',
  name: v.captionEn,
  url: `https://ab.dk/en/abtv/${v.documentId}`,
  ...(v.isPlaylist ? {} : { thumbnailUrl: [youTubeThumbnailUrl(v.youtubeId)] }),
}));

const abtvStructuredData = [itemListSchema('ABTV', videoListItems)];
---

<Base
  locale="en"
  title="ABTV | Match Highlights & Interviews"
  description="Stream match highlights, recaps and exclusive player interviews on ABTV — Akademisk Boldklub's official video channel."
  ogTitle="ABTV – AB's Official Video Hub"
  ogDescription="Catch every goal, recap and behind-the-scenes moment from Akademisk Boldklub on ABTV."
  structuredData={abtvStructuredData}
>

  <!-- ── Compact page title — straight into content, no big hero ────── -->
  <div class="bg-white pt-10 pb-6 px-8 lg:px-16">
    <div class="max-w-7xl mx-auto flex items-end justify-between gap-6">
      <div>
        <h1 class="font-black tracking-[-0.03em] text-[#111]" style="font-size: clamp(1.75rem, 3vw, 2.5rem);">
          ABTV
        </h1>
        <p class="text-[#6B7280] text-sm mt-1">Highlights, matches and exclusive interviews from AB.</p>
      </div>
      <a
        href="https://www.youtube.com/@akademisk-boldklub"
        target="_blank"
        rel="noreferrer"
        class="shrink-0 hidden sm:inline-flex items-center gap-2 text-sm font-bold text-[#111] hover:text-ab-green transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 shrink-0" aria-hidden="true">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        See full channel
      </a>
    </div>
  </div>

  {SECTIONS.map(({ key, heading }) => {
    const sectionVideos = bySection(key);
    if (sectionVideos.length === 0) return null;
    return (
      <section class="bg-white py-8 px-8 lg:px-16">
        <div class="max-w-7xl mx-auto">
          <h2 class="font-black text-[#111] tracking-[-0.02em] mb-5 text-xl md:text-2xl">
            {heading}
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-5 gap-y-9">
            {sectionVideos.map((video) => (
              <VideoCard video={video} locale="en" />
            ))}
          </div>
        </div>
      </section>
    );
  })}

</Base>
