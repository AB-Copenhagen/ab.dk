---
// Fixtures & results — editorial month-grouped list with a next-match hero
// spotlight and a sticky league-table sidebar. Danish counterpart:
// src/pages/kampe.astro (keep both in sync on layout/behavior changes).
import Base from '@/layouts/Base.astro';
import MatchCountdown from '@/components/MatchCountdown.astro';
import StandingsWidget from '@/components/StandingsWidget.astro';
import {
  fetchABEvents,
  isCupMatch,
  getTeamLogoSrc,
  formatEventScore,
  cupTournamentLabel,
  type SIEvent,
} from '@/lib/si/client';
import { abConfig, currentSeasonLabel } from '@/lib/config/ab';
import { fetchBilletTicketMap, findTicketUrl } from '@/lib/billet';
import { fetchMatchTicketUrls } from '@/lib/strapi/client';
import { translate } from '@/lib/i18n';
import { fmtDate, dtAttrs, AB_TIMEZONE, TIME_OPTS } from '@/lib/dateFormat';
import Img from '@/components/Img.astro';
import matchesHeaderBg from '@/assets/images/matches-header-bg.png';
import { setCdnCacheHeaders } from '@/lib/http-cache';
export const prerender = false;
setCdnCacheHeaders(Astro.response.headers);

const locale = 'en';
const dateLocale = 'en-GB';

const now = new Date();
const seasonFrom = new Date(now);
seasonFrom.setMonth(seasonFrom.getMonth() - 11);
const seasonTo = new Date(now);
seasonTo.setMonth(seasonTo.getMonth() + 3);

let events: SIEvent[] = [];
try {
  events = await fetchABEvents({
    locale,
    limit: 200,
    fromDate: seasonFrom.toISOString().slice(0, 10),
    toDate: seasonTo.toISOString().slice(0, 10),
    allCompetitions: true,
  });
} catch {
  /* SI API unavailable */
}

type Filter = 'upcoming' | 'home' | 'away' | 'cup' | 'results';
const filter = (Astro.url.searchParams.get('filter') ?? 'upcoming') as Filter;

const isDone = (e: SIEvent) =>
  e.statusType === 'finished' || e.statusType === 'cancelled';
const upcoming = events
  .filter((e) => !isDone(e))
  .sort((a, b) => new Date(a.startDate).getTime() - new Date(b.startDate).getTime());
const finished = events
  .filter(isDone)
  .sort((a, b) => new Date(b.startDate).getTime() - new Date(a.startDate).getTime());

// Sidebar "Recent Form" strip — cancelled matches excluded (no valid score),
// oldest-to-newest (left-to-right) reading order, the reverse of `finished`.
function matchResult(event: SIEvent): 'W' | 'D' | 'L' | null {
  const score = formatEventScore(event.score);
  if (!score) return null;
  const [h, a] = score.split('-').map(Number);
  if (Number.isNaN(h) || Number.isNaN(a)) return null;
  const isABHome = event.homeId === abConfig.teamId;
  const abGoals = isABHome ? h : a;
  const oppGoals = isABHome ? a : h;
  if (abGoals > oppGoals) return 'W';
  if (abGoals < oppGoals) return 'L';
  return 'D';
}
const recentResults = finished
  .filter((e) => e.statusType === 'finished')
  .slice(0, 5)
  .reverse();

const displayEvents: SIEvent[] =
  filter === 'home' ? upcoming.filter((e) => e.homeId === abConfig.teamId) :
  filter === 'away' ? upcoming.filter((e) => e.homeId !== abConfig.teamId) :
  filter === 'cup' ? upcoming.filter(isCupMatch) :
  filter === 'results' ? finished :
  upcoming;
const isPast = filter === 'results';

const homeEventIds = upcoming.filter((e) => e.homeId === abConfig.teamId).map((e) => e.eventId);
const [billetMap, cmsTicketUrls] = await Promise.all([
  fetchBilletTicketMap().catch(() => new Map<string, string>()),
  fetchMatchTicketUrls(homeEventIds).catch(() => new Map<number, string>()),
]);
const ticketByEventId: Record<number, string> = {};
for (const event of upcoming) {
  if (event.homeId === abConfig.teamId) {
    // CMS override (Strapi match-content.ticketUrl) wins — same precedence as
    // the match detail page — falling back to the billet.ab.dk scrape/fuzzy-
    // match only when no override is set.
    const url = cmsTicketUrls.get(event.eventId) ?? findTicketUrl(billetMap, event.awayName ?? '');
    if (url) ticketByEventId[event.eventId] = url;
  }
}

const nextMatch = upcoming[0] ?? null;

// Group into month sections in AB's local timezone so a late-December match
// doesn't get filed under January just because the ISO string is UTC.
function monthKey(iso: string): string {
  return fmtDate(iso, 'en-CA', { year: 'numeric', month: '2-digit' }, AB_TIMEZONE);
}
function monthLabel(iso: string): string {
  return fmtDate(iso, dateLocale, { month: 'long', year: 'numeric' }, AB_TIMEZONE);
}

const months: { key: string; label: string; matches: SIEvent[] }[] = [];
for (const event of displayEvents) {
  const key = monthKey(event.startDate);
  let bucket = months.find((m) => m.key === key);
  if (!bucket) {
    bucket = { key, label: monthLabel(event.startDate), matches: [] };
    months.push(bucket);
  }
  bucket.matches.push(event);
}

const tabs: { label: string; value: Filter }[] = [
  { label: 'All', value: 'upcoming' },
  { label: 'Home', value: 'home' },
  { label: 'Away', value: 'away' },
  { label: 'Cup', value: 'cup' },
  { label: 'Results', value: 'results' },
];

function emptyMessage(f: Filter): string {
  switch (f) {
    case 'home': return translate(locale, 'noHomeFixtures');
    case 'away': return translate(locale, 'noAwayFixtures');
    case 'cup': return translate(locale, 'noCupFixtures');
    case 'results': return translate(locale, 'noResultsFound');
    default: return translate(locale, 'noUpcomingFixtures');
  }
}

const matchHref = (id: number) => `/en/match/${id}`;

// The homepage's MiniCalendar links to `/en/matches#{YYYY-MM-DD}` for any
// date with a match — give the first row of each date that anchor id so the
// jump actually lands on it. `scroll-mt` offsets for the sticky filter bar.
const seenDates = new Set<string>();
---

<Base
  locale={locale}
  title="Fixtures | Akademisk Boldklub"
  description="AB 1889's full fixture list — kickoff times, venues and tickets for every match this season."
  ogTitle="AB Fixtures"
  ogDescription="Every AB match this season — fixtures, results and the league table."
>
  <!-- Hero — height follows content (title + next-match panel), not the -->
  <!-- banner image, so the photo can't clip the panel on narrow viewports. -->
  <!-- Photo is desktop-only (mirrors MatchHeroPhoto's mobile solid-bg pattern -->
  <!-- used on the match detail pages) — cheaper and reads better on small screens. -->
  <div class="relative overflow-hidden bg-[#0A0A09]">
    <div class="hidden md:block absolute inset-0">
      <Img
        src={matchesHeaderBg}
        alt=""
        class="w-full h-full object-cover opacity-45"
        loading="eager"
        fetchpriority="high"
        widths={[640, 828, 1200, 1920, 3840]}
        sizes="100vw"
      />
      <div class="absolute inset-0" style="background:linear-gradient(180deg, rgba(10,10,9,0.35) 0%, rgba(10,10,9,0.7) 100%);"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-16 pt-10 pb-9 md:pt-14 md:pb-12">
      <p class="text-xs font-bold uppercase tracking-[0.25em] text-ab-neon mb-3">{currentSeasonLabel()} Season</p>
      <h1 class="font-black text-white leading-[0.9] tracking-[-0.04em] normal-case mb-7 md:mb-9" style="font-size:clamp(2.5rem,7vw,5rem);">{translate(locale, 'fixtures')}</h1>

      {nextMatch && (() => {
        const isABHome = nextMatch.homeId === abConfig.teamId;
        const homeName = isABHome ? 'AB' : nextMatch.homeName;
        const awayName = isABHome ? nextMatch.awayName : 'AB';
        const isLive = nextMatch.statusType === 'inprogress';
        const score = formatEventScore(nextMatch.score);
        const venue = nextMatch.properties?.venueName ?? (isABHome ? translate(locale, 'defaultStadium') : nextMatch.homeName);
        const ticketUrl = ticketByEventId[nextMatch.eventId] ?? 'https://billet.ab.dk/';

        return (
          <div class="bg-white/[0.06] border border-white/10 rounded-[6px] px-5 py-6 md:px-8 md:py-7 backdrop-blur-sm">
            <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 mb-5">
              <span class="inline-flex items-center gap-2 text-[0.65rem] font-black uppercase tracking-[0.2em] text-ab-neon">
                {isLive ? (
                  <>
                    <span class="w-1.5 h-1.5 rounded-full bg-current animate-pulse"></span>
                    Live Now
                  </>
                ) : (
                  <>
                    Next Match in <MatchCountdown startDate={nextMatch.startDate} locale="en" variant="inline" />
                  </>
                )}
              </span>
              <span class="text-xs text-white/50">
                <span {...dtAttrs(nextMatch.startDate, dateLocale, { weekday: 'short', day: 'numeric', month: 'short' })}>
                  {fmtDate(nextMatch.startDate, dateLocale, { weekday: 'short', day: 'numeric', month: 'short' })}
                </span>
                {' · '}
                <span {...dtAttrs(nextMatch.startDate, dateLocale, TIME_OPTS)}>{fmtDate(nextMatch.startDate, dateLocale, TIME_OPTS)}</span>
                {' · '}{venue}
                {isCupMatch(nextMatch) && (
                  <>
                    {' · '}
                    <span class="text-ab-beige">{cupTournamentLabel(nextMatch, locale)}</span>
                  </>
                )}
              </span>
            </div>

            <div class="flex flex-col gap-7">
              <!-- Crests — centered, larger; the panel's focal point. -->
              <!-- items-start (not items-center): the two crest+name columns -->
              <!-- can have different total heights when one team's name wraps -->
              <!-- to 2 lines and the other doesn't — items-center would then -->
              <!-- center each column by its own height, misaligning the -->
              <!-- crests themselves instead of just the names below them. -->
              <div class="flex items-start justify-center gap-6 sm:gap-8">
                <div class="flex flex-col items-center gap-2 w-24 sm:w-28 shrink-0">
                  <img src={nextMatch.homeId === abConfig.teamId ? '/images/ab-crest.svg' : getTeamLogoSrc(nextMatch.homeId)} alt="" width="80" height="80" class="w-16 h-16 sm:w-20 sm:h-20 object-contain" loading="eager" onerror="this.style.opacity='0'" />
                  <span class="text-xs sm:text-sm font-bold text-white text-center leading-tight line-clamp-2">{homeName}</span>
                </div>
                {isLive && score ? (
                  <span class="text-2xl font-black tabular-nums text-ab-neon shrink-0 px-1 mt-4 sm:mt-6" style="letter-spacing:-0.02em">{score}</span>
                ) : (
                  <span class="text-sm font-black text-white/25 shrink-0 px-1 mt-6 sm:mt-8">VS</span>
                )}
                <div class="flex flex-col items-center gap-2 w-24 sm:w-28 shrink-0">
                  <img src={nextMatch.awayId === abConfig.teamId ? '/images/ab-crest.svg' : getTeamLogoSrc(nextMatch.awayId)} alt="" width="80" height="80" class="w-16 h-16 sm:w-20 sm:h-20 object-contain" loading="eager" onerror="this.style.opacity='0'" />
                  <span class="text-xs sm:text-sm font-bold text-white text-center leading-tight line-clamp-2">{awayName}</span>
                </div>
              </div>

              <!-- Ticket CTAs -->
              <div class="flex items-center justify-center gap-2">
                {isABHome ? (
                  <a
                    class="vivenu-btn text-center text-xs font-black uppercase tracking-[0.08em] px-4 py-2.5 rounded no-underline text-ab-green whitespace-nowrap"
                    style="background:var(--ab-neon);"
                    href={`${ticketUrl}?useEmbed=true`}
                  >
                    Buy Tickets
                  </a>
                ) : (
                  <span class="text-xs font-bold text-white/40 uppercase tracking-[0.05em] whitespace-nowrap">{translate(locale, 'awayMatch')}</span>
                )}
                <a class="text-center text-xs font-bold px-4 py-2.5 rounded no-underline border border-white/20 text-white hover:bg-white/10 transition-colors whitespace-nowrap" href={matchHref(nextMatch.eventId)}>
                  Details
                </a>
              </div>
            </div>
          </div>
        );
      })()}
    </div>
  </div>

  <!-- Filter bar -->
  <div class="bg-[#0A0A09] border-b border-white/10 sticky top-0 z-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-16 flex items-center justify-between h-[52px] overflow-x-auto">
      <div class="flex items-center gap-6 shrink-0">
        {tabs.map((tab) => (
          <a
            href={tab.value === 'upcoming' ? '/en/matches' : `/en/matches?filter=${tab.value}`}
            class="relative font-bold text-sm py-1 whitespace-nowrap no-underline"
            style={`letter-spacing:-0.01em; color:${filter === tab.value ? '#fff' : 'rgba(255,255,255,0.45)'};`}
          >
            {tab.label}
            {filter === tab.value && (
              <span class="absolute left-0 right-0 -bottom-[15px] h-[2px]" style="background:var(--ab-neon);"></span>
            )}
          </a>
        ))}
      </div>
      <a
        href="https://billet.ab.dk/?useEmbed=true"
        class="vivenu-btn hidden md:inline-flex items-center gap-2 text-xs font-black uppercase tracking-[0.1em] px-4 py-2 rounded-full no-underline shrink-0"
        style="background:var(--ab-neon); color:var(--ab-green);"
      >
        Tickets
      </a>
    </div>
  </div>

  <!-- Body: fixture list + sidebar -->
  <div class="bg-[#F5F5F4] py-10 md:py-14">
    <div class="max-w-7xl mx-auto px-4 md:px-6 lg:px-16 flex flex-col lg:flex-row gap-8 lg:gap-12 items-start">

      <!-- Fixture list -->
      <div class="flex-1 min-w-0 w-full flex flex-col gap-10">
        {months.length === 0 && (
          <div class="text-center py-16 text-sm text-[#777] bg-white rounded border border-gray-200">{emptyMessage(filter)}</div>
        )}
        {months.map((month) => (
          <section>
            <div class="flex items-baseline gap-3 mb-4 pb-2 border-b-2 border-[#111]">
              <h2 class="font-black uppercase tracking-[-0.01em] text-[#111]" style="font-size:1.05rem;">{month.label}</h2>
              <span class="text-xs text-[#888] font-medium">{month.matches.length} {month.matches.length === 1 ? 'match' : 'matches'}</span>
            </div>
            <div class="flex flex-col divide-y divide-gray-200 bg-white border border-gray-200 rounded-[4px] overflow-hidden">
              {month.matches.map((event) => {
                const isABHome = event.homeId === abConfig.teamId;
                const homeName = isABHome ? 'AB' : event.homeName;
                const awayName = isABHome ? event.awayName : 'AB';
                const isCup = isCupMatch(event);
                const isLive = event.statusType === 'inprogress';
                // SI still populates a 0-0 score object before kickoff, so only
                // trust it once the match has actually finished — otherwise an
                // upcoming fixture would misleadingly show "0-0" instead of "v".
                const score = event.statusType === 'finished' ? formatEventScore(event.score) : null;
                const venue = event.properties?.venueName ?? (isABHome ? translate(locale, 'defaultStadium') : event.homeName);
                const ticketUrl = ticketByEventId[event.eventId] ?? 'https://billet.ab.dk/';

                const dateKey = event.startDate.slice(0, 10);
                const isFirstOfDate = !seenDates.has(dateKey);
                if (isFirstOfDate) seenDates.add(dateKey);

                return (
                  <div
                    id={isFirstOfDate ? dateKey : undefined}
                    class="group relative flex items-center gap-3 sm:gap-5 px-3 sm:px-5 py-3.5 scroll-mt-16 hover:bg-[#FAFAF9] transition-colors"
                  >
                    <a
                      href={matchHref(event.eventId)}
                      class="absolute inset-0 z-0"
                      aria-label={`View match: ${homeName} vs ${awayName}`}
                    />
                    <!-- Date block -->
                    <div class="flex flex-col items-center justify-center w-11 sm:w-14 shrink-0 text-center">
                      <span class="text-[0.6rem] font-bold uppercase tracking-[0.05em] text-[#999]" {...dtAttrs(event.startDate, dateLocale, { weekday: 'short' })}>
                        {fmtDate(event.startDate, dateLocale, { weekday: 'short' })}
                      </span>
                      <span class="font-black text-[#111] leading-none" style="font-size:1.4rem;" {...dtAttrs(event.startDate, dateLocale, { day: 'numeric' })}>
                        {fmtDate(event.startDate, dateLocale, { day: 'numeric' })}
                      </span>
                    </div>

                    <!-- Competition + round -->
                    <div class="hidden md:flex flex-col w-[92px] shrink-0 gap-0.5">
                      {isCup ? (
                        <span class="inline-flex w-fit items-center text-[0.6rem] font-black uppercase tracking-[0.05em] text-ab-green bg-ab-beige rounded-full px-2 py-0.5">
                          {cupTournamentLabel(event, locale)}
                        </span>
                      ) : (
                        <span class="text-[0.65rem] font-bold uppercase tracking-[0.04em] text-[#999]">{translate(locale, 'secondDivision')}</span>
                      )}
                      <span class="text-[0.65rem] text-[#BBB]" {...dtAttrs(event.startDate, dateLocale, TIME_OPTS)}>{fmtDate(event.startDate, dateLocale, TIME_OPTS)}</span>
                    </div>

                    <!-- Teams — crest + score/status + crest only, no names. -->
                    <!-- Team names still truncated even at full desktop width -->
                    <!-- once a flex-1 name span had to compete with the score -->
                    <!-- column, venue, and action buttons for space; the crest -->
                    <!-- + row-level "View match: X vs Y" link (above) carry the -->
                    <!-- identity instead. Fixed-width now that there's no -->
                    <!-- variable-length text inside it — see the Venue comment -->
                    <!-- for why that matters for column alignment. -->
                    <div class="shrink-0 flex items-center gap-2 sm:gap-3">
                      <img src={event.homeId === abConfig.teamId ? '/images/ab-crest.svg' : getTeamLogoSrc(event.homeId)} alt={homeName} width="24" height="24" class="w-6 h-6 object-contain shrink-0" loading="lazy" onerror="this.style.opacity='0'" />

                      <div class="w-12 sm:w-16 shrink-0 flex items-center justify-center">
                        {isLive ? (
                          <span class="inline-flex items-center gap-1 text-[0.65rem] font-black uppercase tracking-[0.1em] text-ab-green">
                            <span class="w-1.5 h-1.5 rounded-full bg-current animate-pulse"></span>Live
                          </span>
                        ) : score ? (
                          <span class="font-black tabular-nums text-[#111]" style="font-size:0.9rem;">{score}</span>
                        ) : (
                          <span class="text-[0.65rem] font-bold text-[#BBB]">v</span>
                        )}
                      </div>

                      <img src={event.awayId === abConfig.teamId ? '/images/ab-crest.svg' : getTeamLogoSrc(event.awayId)} alt={awayName} width="24" height="24" class="w-6 h-6 object-contain shrink-0" loading="lazy" onerror="this.style.opacity='0'" />
                    </div>

                    <!-- Venue (desktop only) — the row's one flex-1 element, so -->
                    <!-- it starts at the same x on every row: everything before -->
                    <!-- it (date/competition/teams) is fixed-width, so it doesn't -->
                    <!-- shift depending on whether Tickets renders next to it. -->
                    <span class="hidden lg:block flex-1 min-w-0 text-xs text-[#999] truncate">{venue}</span>

                    <!-- Action -->
                    <div class="relative z-10 shrink-0 ml-auto flex flex-col sm:flex-row items-end sm:items-center gap-1.5 sm:gap-2">
                      {!isPast && isABHome && (
                        <a
                          href={`${ticketUrl}?useEmbed=true`}
                          class="vivenu-btn inline-flex items-center text-[0.65rem] sm:text-[0.7rem] font-black uppercase tracking-[0.05em] px-2.5 py-1 sm:px-3 sm:py-1.5 rounded no-underline text-white whitespace-nowrap"
                          style="background:var(--ab-green);"
                        >
                          Tickets
                        </a>
                      )}
                      <a
                        href={matchHref(event.eventId)}
                        class="inline-flex items-center text-[0.65rem] sm:text-[0.7rem] font-black uppercase tracking-[0.05em] px-2.5 py-1 sm:px-3 sm:py-1.5 rounded no-underline border border-gray-300 text-[#555] whitespace-nowrap hover:border-ab-green hover:text-ab-green transition-colors"
                      >
                        Info
                      </a>
                    </div>
                  </div>
                );
              })}
            </div>
          </section>
        ))}
      </div>

      <!-- Sidebar — league table. `id="standings"` is targeted by the match -->
      <!-- detail pages' "full table" link (MatchStandingsPreview). -->
      <div id="standings" class="w-full lg:w-[340px] shrink-0 lg:sticky lg:top-[68px] scroll-mt-16 flex flex-col gap-4">
        <!-- AB's Recent Form — combined across all competitions (league + cup), -->
        <!-- matching how other match-stats sites report "form"; not split out -->
        <!-- by competition. -->
        {recentResults.length > 0 && (
          <div class="bg-white rounded-[4px] border border-gray-200 p-4">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-4 h-4 text-ab-green shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
              </svg>
              <h3 class="text-xs font-black uppercase tracking-[0.08em] text-[#999]">{translate(locale, 'recentForm')}</h3>
            </div>
            <div class="flex items-center gap-1.5">
              {recentResults.map((event) => {
                const result = matchResult(event);
                const isABHome = event.homeId === abConfig.teamId;
                const opponent = isABHome ? event.awayName : event.homeName;
                const score = formatEventScore(event.score);
                const colors = {
                  W: 'background:var(--ab-green); color:#fff;',
                  D: 'background:#E5E7EB; color:#374151;',
                  L: 'background:#B91C1C; color:#fff;',
                };
                return (
                  <a
                    href={matchHref(event.eventId)}
                    class="w-7 h-7 rounded-full flex items-center justify-center text-[0.7rem] font-black no-underline shrink-0"
                    style={result ? colors[result] : 'background:#E5E7EB; color:#374151;'}
                    title={`${opponent} (${score ?? '—'})`}
                  >
                    {result ?? '?'}
                  </a>
                );
              })}
            </div>
          </div>
        )}

        <div class="bg-white rounded-[4px] border border-gray-200 overflow-hidden">
          <StandingsWidget locale="en" showHeader={true} highlightTeamIds={[abConfig.teamId]} />
        </div>
      </div>
    </div>
  </div>
</Base>
