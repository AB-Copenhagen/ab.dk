---
import Base from '@/layouts/Base.astro';
import VideoPlayer from '@/components/islands/VideoPlayer';
import { streamConfig } from '@/lib/config/ab';

export const prerender = false; // required: auth-gating (middleware + Descope) only runs on SSR routes

// Middleware validates the session and populates Astro.locals.user for this route —
// if we reach here without a user, something's off, so fall back to a login redirect.
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/konto?redirect=/play');
}
---

<Base
  locale="da"
  title="Live | Akademisk Boldklub (AB 1889)"
  description="Se AB's kampe direkte i strømmet video — kun for MyAB-medlemmer."
  ogTitle="Live på AB"
  ogDescription="Se AB's kampe direkte i strømmet video — kun for MyAB-medlemmer."
>
  <section class="bg-ab-black min-h-screen text-white pt-16 pb-24 px-5 md:px-12">
    <div class="max-w-5xl mx-auto">
      <span class="inline-block text-ab-neon font-black text-xs tracking-[0.18em] uppercase mb-5">
        Live
      </span>
      <h1
        class="font-black leading-none tracking-[-0.03em] normal-case mb-8"
        style="font-size: clamp(2rem, 5vw, 3.5rem);"
      >
        Følg kampen direkte
      </h1>
      <VideoPlayer streamUrl={streamConfig.url} title="AB Live" locale="da" client:load />
    </div>
  </section>
</Base>
