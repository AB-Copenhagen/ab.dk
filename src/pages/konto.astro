---
import Base from '@/layouts/Base.astro';
import { isSafeRelativePath } from '@/lib/utils';

export const prerender = false;

// If already authenticated (DS cookie present), go straight to profile
const sessionToken = Astro.cookies.get('DS')?.value;
if (sessionToken) {
  const redirectParam = Astro.url.searchParams.get('redirect');
  const target =
    redirectParam && isSafeRelativePath(redirectParam) ? redirectParam : '/konto/profil';
  return Astro.redirect(target);
}

const DESCOPE_PROJECT_ID = import.meta.env.DESCOPE_PROJECT_ID ?? '';
---

<Base locale="da" title="Min konto | AB 1889">
  <main class="flex min-h-screen items-center justify-center bg-neutral-100 px-4 py-24">
    <div class="w-full max-w-md rounded border border-neutral-200 bg-white p-8">

      {DESCOPE_PROJECT_ID ? (
        <div id="descope-container"></div>
      ) : (
        <div class="border border-neutral-200 p-6 text-center text-sm text-neutral-500">
          {/* TODO(descope): configure DESCOPE_PROJECT_ID to enable login */}
          Login kræver konfiguration. Kontakt AB 1889.
        </div>
      )}

    </div>
  </main>

  {DESCOPE_PROJECT_ID && (
    <script is:inline type="module" define:vars={{ DESCOPE_PROJECT_ID }}>
      import('https://unpkg.com/@descope/web-component@3/dist/index.js').then(() => {
        const el = document.createElement('descope-wc');
        el.setAttribute('project-id', DESCOPE_PROJECT_ID);
        el.setAttribute('flow-id', 'si-app');
        el.setAttribute('theme', 'light');
        el.setAttribute('locale', 'da-DK');

        el.addEventListener('success', async (e) => {
          const sessionJwt = e.detail?.sessionJwt;
          const refreshJwt = e.detail?.refreshJwt;
          const redirectParam = new URLSearchParams(location.search).get('redirect');
          // Block absolute/protocol-relative redirect targets — only ever navigate back into this site.
          const isSafeRelativePath = (url) => url.startsWith('/') && !url.startsWith('//');
          const target = redirectParam && isSafeRelativePath(redirectParam) ? redirectParam : '/konto/profil';
          if (!sessionJwt) return;

          const res = await fetch('/api/auth/session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sessionToken: sessionJwt, refreshToken: refreshJwt }),
          });
          if (res.ok) location.href = target;
        });

        document.getElementById('descope-container')?.appendChild(el);
      });
    </script>
  )}
</Base>
