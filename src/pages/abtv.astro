---
// /abtv now goes straight into the watch experience (the player view) rather
// than the thumbnail grid — "gets users directly into content" was the
// explicit product call here. The grid still exists at /abtv/browse for
// anyone who wants the full overview. Default video = first one in the
// first non-empty category, by sortOrder — fully editor-controllable today
// via section/sortOrder in Strapi, no dedicated "featured" field needed.
import { fetchAbtvVideos, type StrapiAbtvVideo } from '@/lib/strapi/client';
export const prerender = false;

const videos = await fetchAbtvVideos();

const SECTION_ORDER: StrapiAbtvVideo['section'][] = ['trending', 'season', 'behind_the_scenes'];
const bySortOrder = (a: StrapiAbtvVideo, b: StrapiAbtvVideo) => a.sortOrder - b.sortOrder;

let defaultVideo: StrapiAbtvVideo | null = null;
for (const section of SECTION_ORDER) {
  const inSection = videos.filter((v) => v.section === section).sort(bySortOrder);
  if (inSection.length > 0) {
    defaultVideo = inSection[0];
    break;
  }
}

// No videos at all (e.g. Strapi unreachable) — nothing to play, send
// visitors to the browse page instead of a dead end.
return Astro.redirect(defaultVideo ? `/abtv/${defaultVideo.documentId}` : '/abtv/browse', 302);
---
