---
import Base from '@/layouts/Base.astro';
import SiWidget from '@/components/widgets/SiWidget.astro';
import TeamForm from '@/components/TeamForm.astro';
import MatchCountdown from '@/components/MatchCountdown.astro';
import MatchHeroForm from '@/components/MatchHeroForm.astro';
import MatchHeroPhoto from '@/components/MatchHeroPhoto.astro';
import MatchHypeReel from '@/components/MatchHypeReel.astro';
import MatchHighlightCard from '@/components/MatchHighlightCard.astro';
import MatchFeaturedPlayer from '@/components/MatchFeaturedPlayer.astro';
import MatchWatchPartyPromo from '@/components/MatchWatchPartyPromo.astro';
import MatchAppPromo from '@/components/MatchAppPromo.astro';
import MatchStandingsPreview from '@/components/MatchStandingsPreview.astro';
import MatchdayGuideTeaser from '@/components/MatchdayGuideTeaser.astro';
import AwayDayGuideTeaser from '@/components/AwayDayGuideTeaser.astro';
import { fetchEvent, fetchTeamForm, formatEventScore, getTeamLogoSrc, isCupMatch } from '@/lib/si/client';
import type { SIEvent } from '@/lib/si/client';
import { fetchMatchContent, strapiMediaUrl } from '@/lib/strapi/client';
import { abConfig } from '@/lib/config/ab';
import { fetchBilletTicketMap, findTicketUrl } from '@/lib/billet';
import { decodeHtml } from '@/lib/utils';
import { fmtDate, dtAttrs, DATE_LONG_YEAR_OPTS, TIME_OPTS } from '@/lib/dateFormat';
import { setCdnCacheHeaders } from '@/lib/http-cache';
import {
  breadcrumbSchema,
  estimatedMatchEndDate,
  youTubeVideoSchema,
} from '@/lib/structured-data';

export const prerender = false;
setCdnCacheHeaders(Astro.response.headers);

// Slug format: {eventId}-{teams}
const { slug } = Astro.params;
const eventId = slug ? parseInt(slug.split('-')[0], 10) : NaN;

if (isNaN(eventId)) {
  return Astro.redirect('/kampe');
}

let event: SIEvent | null = null;

try {
  event = await fetchEvent(eventId, 'da');
} catch {
  // SI unavailable
}

if (!event) {
  return Astro.redirect('/kampe');
}

const { homeName, awayName, startDate, statusType, tournamentName } = event;
const score = formatEventScore(event.score);

const pageTitle = `${homeName} vs ${awayName} | AB 1889`;

const isLive = statusType === 'inprogress';
const isFinished = statusType === 'finished';
const isUpcoming = !isLive && !isFinished;
const isHome = event.homeId === abConfig.teamId;
// Cup fixtures have no stable SI tournament ID (see isCupMatch's doc comment
// in si/client.ts) — the xG widget needs one, so it's skipped for cup matches
// instead of guessing with the league's ID.
const isCup = isCupMatch(event);

const matchDate = fmtDate(startDate, 'da-DK', { ...DATE_LONG_YEAR_OPTS, ...TIME_OPTS });
const matchDateDay = fmtDate(startDate, 'da-DK', DATE_LONG_YEAR_OPTS);
const matchTime = fmtDate(startDate, 'da-DK', TIME_OPTS);

const beforeDate = startDate.slice(0, 10);
const [cmsMatch, billetMap, homeForm, awayForm] = await Promise.all([
  fetchMatchContent(eventId, 'da').catch(() => null),
  isHome ? fetchBilletTicketMap().catch(() => null) : Promise.resolve(null),
  fetchTeamForm(event.homeId, { beforeDate, locale: 'da' }).catch(() => []),
  fetchTeamForm(event.awayId, { beforeDate, locale: 'da' }).catch(() => []),
]);
const accentColor = cmsMatch?.accentColor ?? 'var(--ab-green)';
const preMatchArticle = cmsMatch?.preMatchArticle ?? null;
const postMatchArticle = cmsMatch?.postMatchArticle ?? null;
const awayTravelArticle = cmsMatch?.awayTravelArticle ?? null;
const otherArticles = [...(cmsMatch?.communityNewsArticles ?? []), ...(cmsMatch?.otherArticles ?? [])];
const socialEmbeds = cmsMatch?.socialEmbeds ?? [];
const hasFeaturedContent = Boolean(preMatchArticle) || Boolean(postMatchArticle) || socialEmbeds.length > 0;

const billetFallback = billetMap
  ? (findTicketUrl(billetMap, awayName) ?? 'https://billet.ab.dk/')
  : isHome
    ? 'https://billet.ab.dk/'
    : null;
const ticketUrl = cmsMatch?.ticketUrl ?? billetFallback;

const venueName = event.properties?.venueName ?? (isHome ? 'Gladsaxe Stadion' : awayName);

const WIDGET_TOURNAMENT_ID = 46;

const matchDescription = `${homeName} mod ${awayName} — ${matchDate} på ${venueName}.`;
const ogImageParams = new URLSearchParams({
  home: homeName,
  away: awayName,
  homeLogo: getTeamLogoSrc(event.homeId),
  awayLogo: getTeamLogoSrc(event.awayId),
  tournament: tournamentName ?? '',
  date: matchDateDay,
  time: matchTime,
  venue: venueName,
  ...(isFinished && score ? { score } : {}),
});
const ogCardImageUrl = `/api/og/match.png?${ogImageParams.toString()}`;

const matchImageUrl = new URL(
  cmsMatch?.bannerImage ? strapiMediaUrl(cmsMatch.bannerImage.url) : ogCardImageUrl,
  Astro.site
).href;

const matchSchema = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: `${homeName} vs ${awayName}`,
  description: matchDescription,
  image: [matchImageUrl],
  startDate,
  endDate: estimatedMatchEndDate(startDate),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: venueName,
    // Only known for home fixtures — the away side's stadium address isn't
    // data we hold anywhere in this codebase.
    ...(isHome
      ? {
          address: {
            '@type': 'PostalAddress',
            streetAddress: 'Gladsaxevej 202',
            addressLocality: 'Søborg',
            postalCode: '2860',
            addressCountry: 'DK',
          },
        }
      : {}),
  },
  homeTeam: { '@type': 'SportsTeam', name: homeName },
  awayTeam: { '@type': 'SportsTeam', name: awayName },
  competitor: [
    { '@type': 'SportsTeam', name: homeName },
    { '@type': 'SportsTeam', name: awayName },
  ],
  organizer: {
    '@type': 'SportsOrganization',
    name: tournamentName,
    url: 'https://ab.dk',
  },
  url: `https://ab.dk/kamp/${eventId}`,
};

const matchBreadcrumbs = breadcrumbSchema([
  { name: 'Forside', url: 'https://ab.dk' },
  { name: 'Kampe', url: 'https://ab.dk/kampe' },
  { name: `${homeName} vs ${awayName}`, url: `https://ab.dk/kamp/${eventId}` },
]);

const matchVideoSchemas = socialEmbeds
  .filter((embed) => embed.platform === 'youtube')
  .map((embed) => youTubeVideoSchema(embed, startDate))
  .filter((schema): schema is NonNullable<typeof schema> => schema !== null);

const matchStructuredData = [matchSchema, matchBreadcrumbs, ...matchVideoSchemas];
---

<Base
  locale="da"
  title={pageTitle}
  description={matchDescription}
  ogImage={ogCardImageUrl}
  structuredData={matchStructuredData}
>

  <!-- Hero -->
  <div class="relative overflow-hidden" style="background:#2A2A2A">
    <MatchHeroPhoto bannerImageUrl={cmsMatch?.bannerImage ? strapiMediaUrl(cmsMatch.bannerImage.url) : null} />
    <div class="relative z-10 max-w-5xl mx-auto px-5 md:px-12 pt-8 pb-10">

      <!-- Back link -->
      <a
        href="/kampe"
        class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.15em] text-white/50 hover:text-white/90 transition-colors mb-8"
      >
        ← Alle kampe
      </a>

      {isUpcoming && <MatchCountdown startDate={startDate} locale="da" />}

      <!-- Competition / round label -->
      {tournamentName && (
        <div class="flex items-center gap-2 mb-6">
          <img src="/images/division-1-logo-white.svg" alt="" aria-hidden="true" class="h-4 w-auto" />
          <p class="text-[0.6rem] font-bold uppercase tracking-[0.22em] text-white">{tournamentName}</p>
        </div>
      )}

      <!-- Teams row -->
      <div class="flex items-center justify-between gap-4 md:gap-8">

        <!-- Home team -->
        <div class="flex-1 flex flex-col items-center gap-3 md:gap-4">
          <div class="w-20 h-20 md:w-28 md:h-28 flex items-center justify-center">
            <img
              src={event.homeId === abConfig.teamId ? '/images/ab-crest.svg' : getTeamLogoSrc(event.homeId)}
              alt={homeName}
              width="112" height="112"
              class="w-full h-full object-contain"
            />
          </div>
          <span class="font-black text-white text-center leading-tight" style="font-size:clamp(0.75rem,2vw,1rem);max-width:140px">{homeName}</span>
          <MatchHeroForm form={homeForm} />
        </div>

        <!-- Centre: score or VS -->
        <div class="flex flex-col items-center gap-2 shrink-0">
          {isUpcoming ? (
            <span class="font-black text-white tracking-[0.12em]" style="font-size:clamp(1.5rem,4vw,2.5rem)">VS</span>
          ) : isLive ? (
            <>
              <span class="font-black tabular-nums text-ab-neon" style="font-size:clamp(2.5rem,7vw,4.5rem);line-height:1">{score}</span>
              <span class="inline-flex items-center gap-1.5 font-bold uppercase tracking-[0.14em] text-ab-neon" style="font-size:0.65rem">
                <span class="w-1.5 h-1.5 rounded-full bg-current animate-pulse"></span>
                LIVE
              </span>
            </>
          ) : (
            <>
              <span class="font-black tabular-nums text-white" style="font-size:clamp(2.5rem,7vw,4.5rem);line-height:1">{score}</span>
              <span class="font-bold text-white/40 uppercase tracking-[0.18em]" style="font-size:0.6rem">Slutresultat</span>
            </>
          )}
        </div>

        <!-- Away team -->
        <div class="flex-1 flex flex-col items-center gap-3 md:gap-4">
          <div class="w-20 h-20 md:w-28 md:h-28 flex items-center justify-center">
            <img
              src={event.awayId === abConfig.teamId ? '/images/ab-crest.svg' : getTeamLogoSrc(event.awayId)}
              alt={awayName}
              width="112" height="112"
              class="w-full h-full object-contain"
            />
          </div>
          <span class="font-black text-white text-center leading-tight" style="font-size:clamp(0.75rem,2vw,1rem);max-width:140px">{awayName}</span>
          <MatchHeroForm form={awayForm} />
        </div>

      </div>

      <!-- Date, time, home/away badge -->
      <div
        class="flex flex-wrap items-center justify-center gap-3 mt-8 mx-auto w-fit px-5 py-3 rounded-2xl"
        style="background:rgba(0,0,0,0.7);backdrop-filter:blur(6px)"
      >
        <!-- Calendar icon + date -->
        <div class="inline-flex items-center gap-2 text-white" style="font-size:0.8125rem">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <rect x="2" y="3" width="12" height="11" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
            <path d="M5 1v3M11 1v3M2 7h12" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          </svg>
          <span class="font-semibold capitalize" {...dtAttrs(startDate, 'da-DK', DATE_LONG_YEAR_OPTS)}>{matchDateDay}</span>
        </div>
        <!-- Clock icon + time -->
        <div class="inline-flex items-center gap-2 text-white" style="font-size:0.8125rem">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.3"/>
            <path d="M8 5v3.5l2 1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="font-semibold" {...dtAttrs(startDate, 'da-DK', TIME_OPTS)}>{matchTime}</span>
        </div>
        <!-- Home / Away badge -->
        <span
          class="inline-flex items-center px-3 py-1 font-black uppercase tracking-[0.14em] rounded-full"
          style={`font-size:0.6rem;${isHome ? 'background:var(--ab-green);color:var(--ab-neon)' : 'background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.92)'}`}
        >
          {isHome ? 'Hjemme' : 'Ude'}
        </span>
        <!-- Venue -->
        <div class="inline-flex items-center gap-2 text-white" style="font-size:0.8125rem">
          <svg width="12" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 1.5C5.515 1.5 3.5 3.515 3.5 6c0 3.5 4.5 8.5 4.5 8.5s4.5-5 4.5-8.5c0-2.485-2.015-4.5-4.5-4.5Z" stroke="currentColor" stroke-width="1.3"/>
            <circle cx="8" cy="6" r="1.5" stroke="currentColor" stroke-width="1.3"/>
          </svg>
          <span>{venueName}</span>
        </div>
      </div>

    </div>
  </div>

  <!-- Match name + key action band -->
  <div class="bg-ab-green">
    <div class="max-w-7xl mx-auto px-5 md:px-12 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-center sm:text-left">
        {tournamentName && (
          <p class="text-[0.6rem] font-bold uppercase tracking-[0.2em] mb-1" style="color:var(--ab-neon)">{tournamentName}</p>
        )}
        <h1 class="font-black text-white" style="font-size:clamp(1.25rem,2.5vw,1.75rem);letter-spacing:-0.02em">
          {homeName} vs. {awayName}
        </h1>
      </div>
      {!isFinished && ticketUrl && (
        <a
          class="vivenu-btn inline-flex items-center gap-2.5 px-8 py-3.5 rounded-[4px] font-black uppercase tracking-[0.1em] shrink-0 transition-transform hover:scale-105"
          href={`${ticketUrl}?useEmbed=true`}
          style="background:#fff;color:var(--ab-gold);font-size:0.875rem"
        >
          <svg width="16" height="16" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <rect x="1" y="4" width="12" height="6" rx="1" stroke="currentColor" stroke-width="1.2" />
            <path d="M10 4v-.5a2 2 0 0 0-4 0V4" stroke="currentColor" stroke-width="1.2" />
          </svg>
          Køb billetter
        </a>
      )}
    </div>
  </div>

  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-5 md:px-12 py-10 lg:py-14">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-8 lg:gap-12 items-start">

        <!-- Main content column -->
        <div class="space-y-14">

          {isUpcoming && (
            <>
              <MatchHypeReel locale="da" />
              <MatchStandingsPreview
                locale="da"
                homeId={event.homeId}
                awayId={event.awayId}
                fullTableHref="/kampe#stilling"
              />
              <TeamForm
                homeId={event.homeId}
                homeName={homeName}
                homeForm={homeForm}
                awayId={event.awayId}
                awayName={awayName}
                awayForm={awayForm}
                locale="da"
              />
            </>
          )}

          {!isUpcoming && (
            <>
              <section>
                <p class="text-[0.6rem] font-bold uppercase mb-2 tracking-[0.2em]" style={`color:${accentColor}`}>
                  {isLive ? 'Live nu' : 'Kampreferat'}
                </p>
                <h2 class="font-black mb-8 text-[#111]" style="font-size:clamp(1.5rem,3vw,2.25rem);letter-spacing:-0.03em">
                  {isLive ? (
                    <span class="inline-flex items-center gap-3">
                      Live
                      <span class="w-3 h-3 rounded-full" style="background:var(--ab-green);box-shadow:0 0 8px color-mix(in srgb, var(--ab-green) 50%, transparent);animation:pulse 1.5s ease-in-out infinite"></span>
                    </span>
                  ) : 'Statistik'}
                </h2>
                <div class="space-y-6">
                  <div>
                    <h3 class="text-[0.6rem] font-bold uppercase mb-3 text-gray-400 tracking-[0.18em]">Momentum</h3>
                    <div class="overflow-hidden" style="background:var(--surface-card-light);border:1px solid var(--surface-card-light-border);padding:1.25rem">
                      <SiWidget
                        locale="da"
                        widget="MatchMomentum"
                        params={{ eventId, card: 'false', transparent: 'true', width: '100%' }}
                        minHeight={360}
                        label="Momentum"
                      />
                    </div>
                  </div>
                  <div>
                    <h3 class="text-[0.6rem] font-bold uppercase mb-3 text-gray-400 tracking-[0.18em]">Hændelser</h3>
                    <div class="overflow-hidden" style="background:var(--surface-card-light);border:1px solid var(--surface-card-light-border);padding:1.25rem">
                      <SiWidget
                        locale="da"
                        widget="IncidentListOpta"
                        params={{ eventId, header: 'false', card: 'false', initialCollapse: 'false', transparent: 'true', width: '100%' }}
                        minHeight={700}
                        label="Hændelser"
                      />
                    </div>
                  </div>
                  <div>
                    <h3 class="text-[0.6rem] font-bold uppercase mb-3 text-gray-400 tracking-[0.18em]">Kampstatistik</h3>
                    <div class="overflow-hidden" style="background:var(--surface-card-light);border:1px solid var(--surface-card-light-border);padding:1.25rem">
                      <SiWidget
                        locale="da"
                        widget="LivePostMatchStatsOpta"
                        params={{ eventId, header: 'false', card: 'false', transparent: 'true', width: '100%' }}
                        minHeight={360}
                        label="Kampstatistik"
                      />
                    </div>
                  </div>
                  {!isCup && (
                    <div>
                      <h3 class="text-[0.6rem] font-bold uppercase mb-3 text-gray-400 tracking-[0.18em]">xG — Forventede mål</h3>
                      <div class="overflow-hidden" style="background:var(--surface-card-light);border:1px solid var(--surface-card-light-border);padding:1.25rem">
                        <SiWidget
                          locale="da"
                          widget="TwoTeamsXGoalsPitch"
                          params={{ eventId, tournamentId: WIDGET_TOURNAMENT_ID, dotSize: 32.5, header: 'true', showHeader: 'false', nopadding: 'true', card: 'false', transparent: 'true', width: '100%' }}
                          minHeight={480}
                          label="xG bane"
                        />
                      </div>
                    </div>
                  )}
                </div>
              </section>
            <TeamForm
              homeId={event.homeId}
              homeName={homeName}
              homeForm={homeForm}
              awayId={event.awayId}
              awayName={awayName}
              awayForm={awayForm}
              locale="da"
            />
            </>
          )}

          {isHome ? (
            <MatchdayGuideTeaser locale="da" />
          ) : (
            <AwayDayGuideTeaser
              locale="da"
              opponentId={event.homeId}
              opponentName={homeName}
              awayTravelArticle={awayTravelArticle}
              ticketUrl={ticketUrl}
            />
          )}
        </div>

        <!-- Sidebar -->
        <aside class="space-y-5 lg:sticky lg:top-24">

          <!-- Pre/Post match reports + related news -->
          {[
            { label: 'Optakt', article: preMatchArticle },
            { label: 'Kampreferat', article: postMatchArticle },
          ].map(({ label, article }) => article && (
            <div class="space-y-4">
              <p class="text-[0.6rem] font-bold uppercase tracking-[0.2em] text-[#888]">{label}</p>
              <a href={`/nyheder/${article.slug}`} class="flex items-start gap-3 group no-underline">
                {article.image ? (
                  <div class="w-16 h-16 rounded overflow-hidden shrink-0 bg-gray-100">
                    <img
                      src={strapiMediaUrl(article.image.url)}
                      alt=""
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  </div>
                ) : (
                  <div class="w-16 h-16 rounded shrink-0 bg-[#F0F4F0] flex items-center justify-center">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M4 6h12M4 10h12M4 14h8" stroke="var(--ab-green)" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </div>
                )}
                <p class="text-sm font-bold text-[#111] leading-snug group-hover:underline line-clamp-3">
                  {decodeHtml(article.title)}
                </p>
              </a>
            </div>
          ))}

          {!isUpcoming && <MatchHighlightCard eventId={eventId} locale="da" />}

          {!hasFeaturedContent && (
            <>
              <MatchFeaturedPlayer locale="da" />
              <MatchWatchPartyPromo locale="da" />
              <MatchAppPromo locale="da" />
            </>
          )}

          {socialEmbeds.length > 0 && (
            <div class="space-y-4">
              <p class="text-[0.6rem] font-bold uppercase tracking-[0.2em] text-[#888]">Social</p>
              <div class="space-y-6">
                {socialEmbeds.map((embed) => (
                  <div class="flex flex-col gap-3">
                    <div set:html={embed.embedCode} />
                    {embed.caption && <p class="text-sm text-[#6B7280]">{embed.caption}</p>}
                  </div>
                ))}
              </div>
            </div>
          )}

          {otherArticles.length > 0 && (
            <div class="space-y-4">
              <p class="text-[0.6rem] font-bold uppercase tracking-[0.2em] text-[#888]">Kampnyheder</p>
              <div class="space-y-4">
                {otherArticles.slice(0, 3).map((article) => (
                  <a href={`/nyheder/${article.slug}`} class="flex items-start gap-3 group no-underline">
                    {article.image ? (
                      <div class="w-16 h-16 rounded overflow-hidden shrink-0 bg-gray-100">
                        <img
                          src={strapiMediaUrl(article.image.url)}
                          alt=""
                          class="w-full h-full object-cover"
                          loading="lazy"
                        />
                      </div>
                    ) : (
                      <div class="w-16 h-16 rounded shrink-0 bg-[#F0F4F0] flex items-center justify-center">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                          <path d="M4 6h12M4 10h12M4 14h8" stroke="var(--ab-green)" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                      </div>
                    )}
                    <p class="text-sm font-bold text-[#111] leading-snug group-hover:underline line-clamp-3">
                      {decodeHtml(article.title)}
                    </p>
                  </a>
                ))}
              </div>
            </div>
          )}
        </aside>

      </div>
    </div>
  </div>

  <script>
    import { localizeDates } from '@/lib/dateFormat.client';
    localizeDates();
  </script>
</Base>
